#!/bin/sh
# dangle: a carrot on a stick for your coding agent.
#
# It works through a folder of plan files, one at a time: each plan gets its own git
# worktree, your agent implements it, your gate checks it, and only what passes lands on
# the base branch. Everything a project needs to change is a file in .dangle/ (see README).
#
# https://github.com/bendangelo/dangle · MIT license
set -u
LC_ALL=C
export LC_ALL
VERSION=0.1.29

# The shell's directory when dangle started. remove_worktree must not delete it: a child cannot
# move its parent shell, so a deleted cwd makes the next prompt warn (mise, for one).
START_DIR=$(pwd -P 2>/dev/null || printf '%s' "${PWD:-}")

# ---------------------------------------------------------------- output

say() { printf '%s\n' "$*"; }
err() { printf 'dangle: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }
QUIET=0
fancy() { [ "$QUIET" = 0 ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; }

art_stick() {
  fancy || return 0
  cat <<'EOF'

   o
    \
     \_______________________
                             |
                             |
                             ?
EOF
}

art_carrot() {
  fancy || return 0
  cat <<'EOF'

        \|/
       \\|//
       .-'-.
       |   |
       |   |
        \ /
         V
EOF
}

# progress <done> <total>: the model (o) walks along the stick toward the carrot ())
progress_bar() {
  local done="$1" total="$2" width=30 pos i bar
  [ "$total" -gt 0 ] || total=1
  pos=$((done * width / total))
  bar='['
  i=0; while [ $i -lt $pos ]; do bar="$bar="; i=$((i + 1)); done
  bar="${bar}o"
  while [ $i -lt $width ]; do bar="$bar."; i=$((i + 1)); done
  printf '%s)' "$bar"
}

minutes() {
  local d=$(($2 - $1))
  if [ $d -lt 60 ]; then printf '%ds' $d; elif [ $d -lt 3600 ]; then printf '%dm' $((d / 60)); else printf '%dh%02dm' $((d / 3600)) $((d % 3600 / 60)); fi
}

# span <seconds>: a short duration for an estimate, at least a minute, without a zero minute part.
span() {
  local d="$1" h m
  [ "$d" -lt 60 ] && d=60
  if [ "$d" -lt 3600 ]; then printf '%dm' $((d / 60)); return; fi
  h=$((d / 3600)); m=$((d % 3600 / 60))
  if [ "$m" = 0 ]; then printf '%dh' "$h"; else printf '%dh%02dm' "$h" "$m"; fi
}

# estimate_run <plans>: a range for the whole run, from the last 20 plan cycles (agent,
# checks and landing). Until there is history, 30m-1h per plan.
estimate_run() {
  local plans="$1" lo=1800 hi=3600 samples=0 total_lo total_hi per
  [ "$plans" != 0 ] || { printf 'estimate  waiting for plans'; return; }
  if [ -s "$STATE/durations" ]; then
    samples=$(tail -n 20 "$STATE/durations" | wc -l | tr -d ' ')
    read -r lo hi <<EOF
$(tail -n 20 "$STATE/durations" | sort -n | awk '{a[NR]=$1} END {
  print a[int(NR * 0.25 + 0.999)], a[int(NR * 0.75 + 0.999)]
}')
EOF
  fi
  total_lo=$((lo * plans)); total_hi=$((hi * plans))
  if [ "$lo" = "$hi" ]; then per="$(span "$lo") each"; else per="$(span "$lo")-$(span "$hi") each"; fi
  if [ "$samples" = 0 ]; then per="$per, no past runs"; else per="$per, from $samples past plans"; fi
  if [ "$total_lo" = "$total_hi" ]; then
    printf 'estimate  ~%s for %s plan(s) (%s)' "$(span "$total_lo")" "$plans" "$per"
  else
    printf 'estimate  ~%s-%s for %s plan(s) (%s)' "$(span "$total_lo")" "$(span "$total_hi")" "$plans" "$per"
  fi
}

record_duration() { printf '%s\n' "$1" >> "$STATE/durations"; }

# ---------------------------------------------------------------- repository and config

find_repo() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"
  COMMON=$(git rev-parse --path-format=absolute --git-common-dir) || die "cannot find the git directory"
  PRIMARY=$(dirname "$COMMON")
  [ -d "$PRIMARY/.git" ] || die "dangle needs a normal (non-bare) repository"
  STATE="$COMMON/dangle"
  DOT="$PRIMARY/.dangle"
  HOOKS="$DOT/hooks"
  mkdir -p "$STATE/claims" "$STATE/logs" "$STATE/results"
}

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

# A config is KEY=value lines. It is read, never run: a value is taken literally. Your own
# (~/.config/dangle/config: your agent, your aliases) is read first; the repository's
# .dangle/config wins where both set a key; DANGLE_* environment variables win over both.
load_config() {
  read_config "${XDG_CONFIG_HOME:-$HOME/.config}/dangle/config"
  read_config "$DOT/config"
}
read_config() {
  local f="$1" line key val
  [ -f "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=$(trim "$line")
    case $line in ''|'#'*) continue ;; *=*) ;; *) err "config: ignoring '$line'"; continue ;; esac
    key=$(trim "${line%%=*}"); val=$(trim "${line#*=}")
    case $key in ''|[0-9]*|*[!A-Za-z0-9_]*) err "config: ignoring key '$key'"; continue ;; esac
    case $val in \"*\") val=${val#\"}; val=${val%\"} ;; \'*\') val=${val#\'}; val=${val%\'} ;; esac
    eval "CFG_$key=\$val"
  done < "$f"
}
# Claude Code when the config names no agent.
DEFAULT_AGENT=claude

# cfg KEY [default]
cfg() {
  local v
  eval "v=\${CFG_$1-}"
  [ -n "$v" ] || [ "$1" != AGENT ] || v=$DEFAULT_AGENT
  if [ -n "$v" ]; then printf '%s' "$v"; else printf '%s' "${2-}"; fi
}

detect_base() {
  local b
  b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) && { printf '%s' "${b#origin/}"; return; }
  for b in main master; do
    git show-ref -q --verify "refs/heads/$b" && { printf '%s' "$b"; return; }
  done
  git -C "$PRIMARY" symbolic-ref -q --short HEAD
}

detect_plans() {
  local d
  for d in docs/superpowers/plans docs/plans plans; do
    [ -d "$PRIMARY/$d" ] && { printf '%s' "$d"; return; }
  done
  printf 'docs/plans'
}

to_secs() {
  case $1 in
    *h) echo $(( ${1%h} * 3600 )) ;;
    *m) echo $(( ${1%m} * 60 )) ;;
    *s) echo "${1%s}" ;;
    *) echo "$1" ;;
  esac
}

settings() {
  load_config
  BASE=${DANGLE_BASE:-$(cfg BASE "$(detect_base)")}
  PLANS=$(cfg PLANS "$(detect_plans)")
  DONE=$(cfg DONE "done")
  WORKTREES=$(cfg WORKTREES .worktrees)
  PREFIX=$(cfg BRANCH_PREFIX plan-)
  FIXES=$(cfg FIXES 1)
  MAX_LINES=$(cfg MAX_LINES 300)
  AGENT_SECS=$(to_secs "$(cfg AGENT_TIMEOUT 4h)")
  GATE_SECS=$(to_secs "$(cfg GATE_TIMEOUT 60m)")
  HB_SECS=$(to_secs "$(cfg HEARTBEAT 5m)")
  STALL_SECS=$(to_secs "$(cfg STALL_TIMEOUT 60m)")
  # Disk: worktrees idle for PRUNE_DAYS days, or over PRUNE_MAX_GB, are pruned with the
  # .dangle/hooks/prune hook at the start and end of a run. 0 turns either rule off.
  PRUNE_DAYS=$(cfg PRUNE_DAYS 3)
  PRUNE_MAX_GB=$(cfg PRUNE_MAX_GB 0)
  case $PRUNE_DAYS in ''|*[!0-9]*) PRUNE_DAYS=3 ;; esac
  case $PRUNE_MAX_GB in ''|*[!0-9]*) PRUNE_MAX_GB=0 ;; esac
  # QUEUE=batch: a landing joins the merge queue instead of running its own gate (queue_land).
  QUEUE=${DANGLE_QUEUE:-$(cfg QUEUE off)}
  QUEUE_BRANCH=$(cfg QUEUE_BRANCH dangle-queue)
  # PIPELINE=N: a plan whose agent has finished lands in the background (gate, fix-ups, queue)
  # while the runner starts the next plan; at most N land at once. 0 = one plan at a time.
  # A plan that waits only for one landing here starts on that plan's branch.
  PIPELINE=${DANGLE_PIPELINE:-$(cfg PIPELINE 0)}
  case $PIPELINE in ''|*[!0-9]*) PIPELINE=0 ;; esac
  # REMOTE_CLAIMS=1: claims are also refs on the remote (refs/dangle/claims/<id>), so runners
  # on different computers never take the same plan. CLAIM_TTL: when a claim is stale.
  REMOTE_CLAIMS=${DANGLE_REMOTE_CLAIMS:-$(cfg REMOTE_CLAIMS 0)}
  CLAIM_SECS=$(to_secs "$(cfg CLAIM_TTL 12h)")
  HOST=$(hostname 2>/dev/null || uname -n 2>/dev/null || echo unknown)
  # Private plans: a plans folder git ignores (kept out of a public repository). They are read
  # from the main checkout, copied into each worktree, and moved to the done folder on disk.
  PRIVATE=0
  git -C "$PRIMARY" check-ignore -q "$PLANS/x.md" 2>/dev/null && PRIVATE=1
  REMOTE=${DANGLE_REMOTE:-$(cfg REMOTE origin)}
  if [ "$REMOTE" = none ] || ! git remote get-url "$REMOTE" >/dev/null 2>&1; then REMOTE=; fi
  TIMEOUT_BIN=
  if [ "${DANGLE_TIMEOUT_BIN-}" = none ]; then :
  elif command -v timeout >/dev/null 2>&1; then TIMEOUT_BIN=timeout
  elif command -v gtimeout >/dev/null 2>&1; then TIMEOUT_BIN=gtimeout; fi
}

# ---------------------------------------------------------------- agents

# A preset is the headless form of a known agent CLI. Anything else is a command of your own.
preset() {
  case $1 in
    pi) echo "pi -p --mode json --approve" ;;
    opencode) echo "opencode run --auto" ;;
    claude) echo "claude -p --output-format stream-json --verbose --dangerously-skip-permissions" ;;
    codex) echo "codex exec --dangerously-bypass-approvals-and-sandbox" ;;
    *) return 1 ;;
  esac
}

# resolve_agent <spec> <default spec>: sets AGENT_CMD (words) and AGENT_LABEL.
# A spec is `name[:model] [extra args]`: a preset (claude, codex, opencode, pi), an
# ALIAS_<name> from the config, a command of your own, or a bare model for the default agent.
resolve_agent() {
  local spec="$1" fallback="${2-}" first rest name model n=0 alias
  while :; do
    first=${spec%% *}; rest=${spec#"$first"}
    name=${first%%:*}; model=
    case $first in *:*) model=${first#*:} ;; esac
    case $name in *[!A-Za-z0-9_]*|'') alias= ;; *) alias=$(cfg "ALIAS_$name") ;; esac
    [ -n "$alias" ] && [ $n -lt 5 ] || break
    if [ -n "$model" ]; then spec="${alias%%:*}:$model${alias#"${alias%% *}"}$rest"; else spec="$alias$rest"; fi
    n=$((n + 1))
  done
  if preset "$name" >/dev/null; then
    AGENT_CMD="$(preset "$name")${model:+ --model $model}$rest"
    AGENT_LABEL="$name${model:+:$model}"
  elif case $first in */*) true ;; *) command -v "$first" >/dev/null 2>&1 ;; esac; then
    AGENT_CMD="$spec"; AGENT_LABEL="$first"
  elif [ -n "$fallback" ] && [ "$fallback" != "$spec" ]; then
    # A bare model: the default agent with this model.
    local dname
    resolve_agent "$fallback" ""
    dname=${AGENT_LABEL%%:*}
    preset "$dname" >/dev/null || die "'$spec' is not an agent, and the default agent ($dname) is not a preset to give a model to"
    resolve_agent "$dname:$spec" ""
  else
    die "unknown agent '$spec' (presets: claude, codex, opencode, pi; or an ALIAS_ in .dangle/config, or a command)"
  fi
}

# ---------------------------------------------------------------- running things

# stop_tree <pid>: stops a command and the processes below it. A shell waiting on a child holds
# SIGTERM until that child exits, so a stuck agent's `sleep` would keep the log pipe open for
# its whole nap. Signal the children first, then the shell.
stop_tree() {
  local pid="$1" kid kids
  kids=$(ps -A -o pid=,ppid= 2>/dev/null | awk -v p="$pid" '$2 == p { print $1 }')
  for kid in $kids; do stop_tree "$kid"; done
  kill -TERM "$pid" 2>/dev/null
  return 0
}

# run_limited <secs> <cmd...>: runs a command with a time limit. Ctrl-C stops it too.
CHILD=
run_limited() {
  local t="$1" rc watch=''
  shift
  if [ -n "$TIMEOUT_BIN" ]; then
    "$TIMEOUT_BIN" -k 30 "$t" "$@" &
    CHILD=$!
  else
    "$@" &
    CHILD=$!
    # The watcher holds no output open (a pipe after dangle would wait for it) and takes its
    # sleep with it when it is stopped.
    ( s=''; trap '[ -n "$s" ] && kill "$s" 2>/dev/null; exit 0' TERM
      sleep "$t" & s=$!; wait "$s" && stop_tree "$CHILD" ) < /dev/null > /dev/null 2>&1 &
    watch=$!
  fi
  # BG names a landing in the background (PIPELINE), which shares this run's pid.
  echo "$CHILD" > "$STATE/child.$$${BG-}"
  wait "$CHILD"; rc=$?
  rm -f "$STATE/child.$$${BG-}"
  [ -n "$watch" ] && kill "$watch" 2>/dev/null
  CHILD=
  return $rc
}

# readable: turns an agent's JSON event stream (pi --mode json, claude stream-json) into one
# line per step, `→ bash cargo test` or the agent's text, so the log and the heartbeat say
# what it is doing. Any other line passes through as it is.
readable() {
  awk '
    function str(key,   m, v) {
      if (!match($0, "\"" key "\":\"([^\"\\\\]|\\\\.)*\"")) return ""
      v = substr($0, RSTART + length(key) + 4, RLENGTH - length(key) - 5)
      gsub(/\\n/, "\n", v); gsub(/\\t/, " ", v); gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v)
      return v
    }
    function arg(   k, v) {
      split("command file_path path pattern", k, " ")
      for (i = 1; i <= 4; i++) if ((v = str(k[i])) != "") return substr(v, 1, 120)
      return ""
    }
    function texts(   rest, t, out) {
      rest = $0; out = ""
      while (match(rest, /"type":"text","text":"([^"\\]|\\.)*"/)) {
        t = substr(rest, RSTART + 22, RLENGTH - 23); rest = substr(rest, RSTART + RLENGTH)
        gsub(/\\n/, "\n", t); gsub(/\\"/, "\"", t); gsub(/\\\\/, "\\", t)
        if (t ~ /[^[:space:]]/) out = out (out == "" ? "" : "\n") t
      }
      return out
    }
    !/^\{/ { print; fflush(); next }
    /"type":"tool_execution_start"/ { print "→ " str("toolName") " " arg(); fflush(); next }
    /"type":"message_end"/ && /"role":"assistant"/ { t = texts(); if (t != "") print t; e = str("errorMessage"); if (e != "") print "error: " e; fflush(); next }
    /^\{"type":"assistant"/ {
      t = texts(); if (t != "") print t
      rest = $0
      while (match(rest, /"type":"tool_use"[^}]*"name":"[^"]*"/)) {
        seg = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
        sub(/.*"name":"/, "", seg); sub(/"$/, "", seg)
        line = $0; $0 = rest; a = arg(); $0 = line
        print "→ " seg " " a
      }
      fflush(); next
    }
    /"type":"result"/ && /"session_id"/ { print "[done] " str("subtype"); fflush(); next }
  '
}

# heartbeat <what> <log>: every HEARTBEAT (5m) while something runs, one line: how long it
# has run and the last line of its log. Stopped with stop_heartbeat.
HB=
heartbeat() {
  [ "$HB_SECS" -gt 0 ] || return 0
  local what="$1" log="$2" start
  start=$(date +%s)
  (
    s=''
    trap '[ -n "$s" ] && kill "$s" 2>/dev/null; exit 0' TERM
    while :; do
      sleep "$HB_SECS" & s=$!
      wait "$s" || exit 0
      line=$(tail -n 40 "$log" 2>/dev/null | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g; s/\r//g' | grep -v '^[[:space:]]*$' | tail -n 1 | cut -c1-90)
      say "  ...    $what $(minutes "$start" "$(date +%s)")${line:+  │ $line}"
    done
  ) &
  HB=$!
}
stop_heartbeat() { [ -n "$HB" ] && kill "$HB" 2>/dev/null; HB=; return 0; }

# stall_watch <worktree> <log>: stops the agent when its worktree has had no new commit for
# STALL_TIMEOUT (0 = off): an agent stuck on one failure can loop until AGENT_TIMEOUT. It leaves
# <log>.stalled for run_agent to report. Stopped with stop_stall_watch.
STALL=
stall_watch() {
  [ "$STALL_SECS" -gt 0 ] || return 0
  local dir="$1" log="$2"
  (
    s=''
    trap '[ -n "$s" ] && kill "$s" 2>/dev/null; exit 0' TERM
    step=60; [ "$STALL_SECS" -lt $step ] && step=$STALL_SECS
    head=$(git -C "$dir" rev-parse -q --verify HEAD 2>/dev/null); since=$(date +%s)
    while :; do
      sleep "$step" & s=$!
      wait "$s" || exit 0
      now=$(git -C "$dir" rev-parse -q --verify HEAD 2>/dev/null)
      if [ "$now" != "$head" ]; then head=$now; since=$(date +%s); continue; fi
      [ $(( $(date +%s) - since )) -ge "$STALL_SECS" ] || continue
      pid=$(cat "$STATE/child.$$" 2>/dev/null) || continue
      : > "$log.stalled"
      stop_tree "$pid"
      exit 0
    done
  ) < /dev/null > /dev/null 2>&1 &
  STALL=$!
}
stop_stall_watch() { [ -n "$STALL" ] && kill "$STALL" 2>/dev/null; STALL=; return 0; }

# hook <name> <dir> [args...]: runs .dangle/hooks/<name> in <dir> if it exists.
hook() {
  local name="$1" dir="$2"
  shift 2
  [ -x "$HOOKS/$name" ] || return 0
  ( cd "$dir" && DANGLE_HOOK=$name "$HOOKS/$name" "$@" )
}
has_hook() { [ -x "$HOOKS/$1" ]; }

export_ctx() { # <worktree> <branch>
  DANGLE_PRIMARY=$PRIMARY DANGLE_WORKTREE=$1 DANGLE_BRANCH=$2 DANGLE_BASE=$BASE
  export DANGLE_PRIMARY DANGLE_WORKTREE DANGLE_BRANCH DANGLE_BASE
}

# ---------------------------------------------------------------- locks and claims

# take_lock <dir> <what>: waits for a lock held by a live process; clears a dead one's.
take_lock() {
  local dir="$1" what="$2" pid said=''
  while ! mkdir "$dir" 2>/dev/null; do
    pid=$(cat "$dir/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then rm -rf "$dir"; continue; fi
    [ -n "$said" ] || { say "  waiting for $what${pid:+ (pid $pid)}"; said=1; }
    sleep 3
  done
  echo $$ > "$dir/pid"
}
drop_lock() { [ "$(cat "$1/pid" 2>/dev/null)" = $$ ] && rm -rf "$1"; return 0; }

# claim <id>: 0 when this process now owns the plan, 1 when another live dangle runs it.
claim() {
  local dir="$STATE/claims/$1" pid
  while ! mkdir "$dir" 2>/dev/null; do
    pid=$(cat "$dir/pid" 2>/dev/null || true)
    [ "$pid" = $$ ] && return 0
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then return 1; fi
    [ -n "$pid" ] || sleep 1
    rm -rf "$dir"
  done
  echo $$ > "$dir/pid"
}
# unclaim <id>: lets go of the plan, and of its claim on the remote when this run pushed one.
unclaim() {
  local sha
  sha=$(cat "$STATE/claims/$1/remote" 2>/dev/null || true)
  if [ -n "$sha" ] && remote_claims && [ "$(cat "$STATE/claims/$1/pid" 2>/dev/null)" = $$ ]; then
    git push -q --force-with-lease="refs/dangle/claims/$1:$sha" "$REMOTE" ":refs/dangle/claims/$1" \
      2>/dev/null || true
  fi
  drop_lock "$STATE/claims/$1"
}

# ---------------------------------------------------------------- claims on the remote
# REMOTE_CLAIMS=1: a claim is also the ref refs/dangle/claims/<id> on the remote, pointing at a
# commit of its own (no parent; its message names the computer and the process). When two
# computers claim one plan, git refuses the second push (it is not a fast-forward), so only one
# runs it. A claim older than CLAIM_TTL, or one this computer left behind (its process is
# gone), is stale and may be taken over. refs/dangle/seen/ is this clone's copy of them.
remote_claims() { [ "$REMOTE_CLAIMS" = 1 ] && [ -n "$REMOTE" ]; }

# claims_seen: refreshes refs/dangle/seen/ from the remote (one fetch; quiet when offline).
claims_seen() {
  remote_claims || return 0
  git fetch -q --prune --no-tags "$REMOTE" '+refs/dangle/claims/*:refs/dangle/seen/*' 2>/dev/null || true
}

# claim_live <sha>: the claim commit is fresh, and not left behind by a dead run on this computer.
claim_live() {
  local body at host pid
  body=$(git log -1 --format=%B "$1" 2>/dev/null) || return 1
  at=$(git log -1 --format=%ct "$1")
  [ $(( $(date +%s) - at )) -le "$CLAIM_SECS" ] || return 1
  host=$(printf '%s\n' "$body" | sed -n 's/^host //p')
  pid=$(printf '%s\n' "$body" | sed -n 's/^pid //p')
  if [ "$host" = "$HOST" ] && [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then return 1; fi
  return 0
}

# claim_host <id>: the computer whose live remote claim holds the plan (not this clone's).
claim_host() {
  remote_claims || return 1
  local name sha
  for name in $(git for-each-ref --format='%(refname:lstrip=3)' refs/dangle/seen/); do
    is_id "$1" "$name" || continue
    sha=$(git rev-parse "refs/dangle/seen/$name")
    [ "$sha" != "$(cat "$STATE/claims/$name/remote" 2>/dev/null)" ] || continue
    claim_live "$sha" || continue
    git log -1 --format=%B "$sha" | sed -n 's/^host //p'
    return 0
  done
  return 1
}

# remote_claim <id>: pushes the claim; 1 when another live run holds it. A remote that cannot be
# reached does not stop the plan: the local claim still holds on this computer.
remote_claim() {
  remote_claims || return 0
  local id="$1" ref sha have
  ref="refs/dangle/claims/$1"
  [ -f "$STATE/claims/$id/remote" ] && return 0
  sha=$(printf 'dangle claim %s\n\nhost %s\npid %s\n' "$id" "$HOST" $$ |
    git commit-tree "$(git hash-object -t tree -w /dev/null)") || return 0
  if git push -q "$REMOTE" "$sha:$ref" 2>/dev/null; then
    echo "$sha" > "$STATE/claims/$id/remote"; return 0
  fi
  if ! git fetch -q --no-tags "$REMOTE" "+$ref:refs/dangle/seen/$id" 2>/dev/null; then
    # Released meanwhile, or the remote is out of reach: one more try, then go on.
    git push -q "$REMOTE" "$sha:$ref" 2>/dev/null && echo "$sha" > "$STATE/claims/$id/remote"
    return 0
  fi
  have=$(git rev-parse -q --verify "refs/dangle/seen/$id") || return 0
  claim_live "$have" && return 1
  if git push -q --force-with-lease="$ref:$have" "$REMOTE" "$sha:$ref" 2>/dev/null; then
    say "  claim  took over a stale claim on $id"
    echo "$sha" > "$STATE/claims/$id/remote"; return 0
  fi
  return 1
}

# ready_live <id>: the plan's agent has finished here and its landing is under way (PIPELINE):
# $STATE/ready/<id> holds its branch and the pid of the run landing it.
ready_live() {
  local pid
  [ -f "$STATE/ready/$1" ] || return 1
  pid=$(sed -n 2p "$STATE/ready/$1")
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}
mark_ready() { mkdir -p "$STATE/ready" && printf '%s\n%s\n' "$2" $$ > "$STATE/ready/$1"; }

cleanup() {
  stop_heartbeat
  [ -n "$CHILD" ] && stop_tree "$CHILD"
  local d c
  # Landings in the background (PIPELINE) stop with the run; their branches are kept.
  for d in "$STATE"/bg/$$.*; do
    [ -f "$d/pid" ] && stop_tree "$(cat "$d/pid")"
    rm -rf "$d"
  done
  # An agent started in a subshell (run_agent) records its pid here.
  for c in "$STATE"/child.$$ "$STATE"/child.$$.*; do
    [ -f "$c" ] && stop_tree "$(cat "$c")" && rm -f "$c"
  done
  for d in "$STATE"/ready/*; do
    [ -f "$d" ] && [ "$(sed -n 2p "$d")" = $$ ] && rm -f "$d"
  done
  for d in "$STATE"/claims/*; do [ -d "$d" ] && unclaim "${d##*/}"; done
  drop_lock "$STATE/land.lock"
  drop_lock "$STATE/queue.lock"
  [ -z "$QUEUE_ENTRY" ] || rm -rf "$QUEUE_ENTRY"
  rm -f "$STATE/started.$$"
}

# ---------------------------------------------------------------- the base branch

# The worktree that has the base branch checked out, if any (usually the main checkout).
base_checkout() {
  git worktree list --porcelain | awk -v b="refs/heads/$BASE" '
    /^worktree /{w=substr($0,10)} $0=="branch " b {print w; exit}'
}

require_clean_base() {
  local bw
  bw=$(base_checkout)
  [ -n "$bw" ] || return 0
  if [ -n "$(git -C "$bw" status --porcelain --untracked-files=no)" ]; then
    err "$bw has uncommitted changes on $BASE; commit or stash them first:"
    git -C "$bw" status --short --untracked-files=no >&2
    exit 1
  fi
}

# advance_base <new sha> <old sha>: moves the base branch forward, and its checkout with it.
# Commits made on the base branch since <old sha> (plans, notes committed while the gate ran)
# are rebased onto <new sha>, as sync_base does with commits that are not pushed yet.
advance_base() {
  local bw head
  bw=$(base_checkout)
  if [ -n "$bw" ]; then
    git -C "$bw" merge -q --ff-only "$1" 2>/dev/null && return 0
    head=$(git -C "$bw" rev-parse HEAD)
    git merge-base --is-ancestor "$2" "$head" ||
      die "could not fast-forward $BASE in $bw to $(git rev-parse --short "$1")"
    git -C "$bw" rebase -q --autostash --onto "$1" "$2" >/dev/null 2>&1 || {
      git -C "$bw" rebase --abort 2>/dev/null
      die "$BASE in $bw got commits while landing that do not rebase onto $(git rev-parse --short "$1"); rebase $BASE onto it by hand"
    }
    say "  land   rebased $(git -C "$bw" rev-list --count "$1..HEAD") commit(s) made on $BASE meanwhile"
  else
    git update-ref "refs/heads/$BASE" "$1" "$2" || die "could not move $BASE"
  fi
}

# sync_base: brings the local base branch up to date with the remote. Local commits that are
# not pushed yet (plans, notes) are rebased onto the remote's.
sync_base() {
  [ -n "$REMOTE" ] || return 0
  local here there bw why
  if ! why=$(git fetch -q "$REMOTE" "$BASE" 2>&1 >/dev/null); then
    # Say git's own reason, once: a run that waits on another runner polls sync_base every
    # 30s, and the same failure should not fill the terminal. A later, different failure is
    # reported again.
    [ -n "$why" ] || why='git fetch failed'
    if [ "${FETCH_WHY:-}" != "$why" ]; then
      FETCH_WHY=$why
      err "could not fetch $REMOTE/$BASE; going on with the local $BASE"
      printf '%s\n' "$why" | sed 's/^/  /' >&2
    fi
    return 0
  fi
  here=$(git rev-parse "refs/heads/$BASE"); there=$(git rev-parse "refs/remotes/$REMOTE/$BASE")
  [ "$here" = "$there" ] && return 0
  if git merge-base --is-ancestor "$here" "$there"; then
    advance_base "$there" "$here"
  elif git merge-base --is-ancestor "$there" "$here"; then
    return 0
  else
    bw=$(base_checkout)
    [ -n "$bw" ] || die "$BASE and $REMOTE/$BASE have diverged; rebase $BASE first"
    git -C "$bw" rebase -q "$REMOTE/$BASE" >/dev/null 2>&1 || {
      git -C "$bw" rebase --abort 2>/dev/null
      die "$BASE and $REMOTE/$BASE have diverged and do not rebase cleanly; fix $BASE by hand"
    }
  fi
}

# synced: sync_base under the land lock, so two runners never move the base branch at once.
synced() {
  take_lock "$STATE/land.lock" "another runner's landing"
  sync_base
  drop_lock "$STATE/land.lock"
}

# ---------------------------------------------------------------- worktrees

wt_path() { printf '%s/%s/%s' "$PRIMARY" "$WORKTREES" "$1"; }

ensure_excluded() {
  local ex="$COMMON/info/exclude"
  mkdir -p "$COMMON/info"
  git -C "$PRIMARY" check-ignore -q "$WORKTREES/x" 2>/dev/null && return 0
  printf '/%s/\n' "$WORKTREES" >> "$ex"
}

# copy_into <worktree>: the paths in .dangle/copy, copied (copy-on-write where the disk can)
# or linked from the main checkout. Lines: `path`, `link path`, globs allowed, # comments.
copy_into() {
  local dst="$1" line kind p
  [ -f "$DOT/copy" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=$(trim "$line")
    case $line in ''|'#'*) continue ;; 'link '*) kind='link'; line=$(trim "${line#link }") ;; *) kind='copy' ;; esac
    for p in $(cd "$PRIMARY" && eval "printf '%s\n' $line" 2>/dev/null); do
      [ -e "$PRIMARY/$p" ] || continue
      [ -e "$dst/$p" ] && continue
      mkdir -p "$(dirname "$dst/$p")"
      if [ $kind = link ]; then
        ln -s "$PRIMARY/$p" "$dst/$p"
      elif ! cp -a --reflink=auto "$PRIMARY/$p" "$dst/$p" 2>/dev/null; then
        cp -Rc "$PRIMARY/$p" "$dst/$p" 2>/dev/null || cp -R "$PRIMARY/$p" "$dst/$p"
      fi
    done
  done < "$DOT/copy"
}

# caller_inside <dir>: 0 when the shell that started dangle stands in <dir> or below it.
caller_inside() {
  local real
  real=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  case "$START_DIR/" in "$real"/*) return 0 ;; esac
  return 1
}

# dir_in_use <dir>: 0 when any live process stands in <dir> or below it.
dir_in_use() {
  local real p cwd
  real=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  if [ -d /proc ]; then
    for p in /proc/[0-9]*/cwd; do
      cwd=$(readlink "$p" 2>/dev/null) || continue
      case "$cwd/" in "$real"/*) return 0 ;; esac
    done
    return 1
  fi
  command -v lsof >/dev/null 2>&1 || return 1
  lsof -a -d cwd -Fn 2>/dev/null | awk -v d="$real/" '
    /^n/ { if (index(substr($0, 2) "/", d) == 1) found = 1 }
    END { exit(found ? 0 : 1) }'
}

# remove_worktree_here <path>: empty a worktree that the caller's shell stands in (or in a
# subdirectory of). A child cannot move its parent shell, so deleting the directory would leave
# the shell in a cwd that no longer exists and the next prompt would warn (mise does). The .git
# link goes, so `git worktree prune` drops the registration, but the directories from the root
# down to the shell's cwd stay. The empty tree is a tombstone: clear_tombstones removes it once
# nobody stands in it.
remove_worktree_here() {
  local path="$1" real rel cur part
  real=$(cd "$path" && pwd -P) || return 1
  rel=${START_DIR#"$real"}
  rm -rf -- "$path/.git"
  cur="$path"
  while [ -n "$rel" ]; do
    rel=${rel#/}
    part=${rel%%/*}
    if [ "$part" = "$rel" ]; then rel=''; else rel=${rel#*/}; fi
    find "$cur" -mindepth 1 -maxdepth 1 ! -name "$part" -exec rm -rf -- {} +
    cur="$cur/$part"
  done
  find "$cur" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  : > "$path/.dangle-landed"
  say "  note   your shell is in $path; the worktree is empty now, and the next dangle run from outside removes it"
}

# clear_tombstones: remove the empty placeholders a landing left in the directory a shell stood
# in, once that shell has moved on.
clear_tombstones() {
  local d
  [ -d "$PRIMARY/$WORKTREES" ] || return 0
  for d in "$PRIMARY/$WORKTREES"/*; do
    [ -d "$d" ] && [ -f "$d/.dangle-landed" ] || continue
    { caller_inside "$d" || dir_in_use "$d"; } && continue
    rm -rf -- "$d"
  done
  return 0
}

# new_worktree <branch> [base]: creates (or re-opens) the branch's worktree, copies the
# files in .dangle/copy, runs the setup hook.
new_worktree() {
  local branch="$1" from="${2:-$BASE}" path
  path=$(wt_path "$branch")
  if [ -f "$path/.dangle-landed" ]; then
    caller_inside "$path" &&
      die "$path is an empty leftover of a landed worktree and your shell is in it; cd out first"
    rm -rf -- "$path"
  fi
  [ -e "$path" ] && die "$path already exists"
  ensure_excluded
  mkdir -p "$(dirname "$path")"
  if git show-ref -q --verify "refs/heads/$branch"; then
    git worktree add -q "$path" "$branch" || return 1
  else
    git worktree add -q -b "$branch" "$path" "$from" || return 1
    # Where the branch started: on_base tells a branch with no work yet from one whose work
    # has since reached the base branch.
    git config "branch.$branch.danglebase" "$(git rev-parse "$from")"
  fi
  copy_into "$path"
  if [ "$PRIVATE" = 1 ]; then
    mkdir -p "$path/$PLANS" && cp -R "$PRIMARY/$PLANS/." "$path/$PLANS/"
  fi
  export_ctx "$path" "$branch"
  hook setup "$path" || { err "the setup hook failed in $path"; return 1; }
}

# remove_worktree <branch> [force]: runs the teardown hook, removes the worktree and branch.
remove_worktree() {
  local branch="$1" force="${2-}" path here=0
  path=$(wt_path "$branch")
  caller_inside "$path" && here=1
  # The caller may be standing in the worktree that is about to go.
  cd "$PRIMARY" || return 1
  if [ -d "$path" ]; then
    export_ctx "$path" "$branch"
    hook teardown "$path" || err "the teardown hook failed (going on)"
    if [ "$here" = 1 ]; then
      remove_worktree_here "$path" || return 1
    else
      git worktree remove ${force:+--force} "$path" || return 1
    fi
  fi
  git worktree prune
  if git show-ref -q --verify "refs/heads/$branch"; then
    if [ -n "$force" ]; then git branch -q -D "$branch"; else git branch -q -d "$branch"; fi
  fi
}

# ---------------------------------------------------------------- disk

# wt_kb <path>: KiB a worktree uses (`du -sk`), 0 when it fails.
wt_kb() { du -sk "$1" 2>/dev/null | awk 'NR == 1 { print $1 + 0 }'; }

# human_kb <kb>: 12.3G, 900M, 640K.
human_kb() {
  awk -v k="${1:-0}" 'BEGIN {
    if (k >= 1048576) printf "%.1fG", k / 1048576
    else if (k >= 1024) printf "%.0fM", k / 1024
    else printf "%dK", k }'
}

# file_epoch <file>: its mtime in seconds (GNU and BSD stat).
file_epoch() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

# wt_idle_days <branch>: whole days since dangle last finished a plan in the worktree (its
# result file), or since the branch tip was committed for a worktree dangle has no result
# for (the merge queue's, or one made with `dangle new`).
wt_idle_days() {
  local branch="$1" id='' since=0 now
  case $branch in "$PREFIX"*) id=${branch#"$PREFIX"} ;; esac
  if [ -n "$id" ] && [ -f "$STATE/results/$id" ]; then since=$(file_epoch "$STATE/results/$id"); fi
  [ "$since" != 0 ] || since=$(git log -1 --format=%ct "refs/heads/$branch" 2>/dev/null || echo 0)
  case $since in ''|*[!0-9]*) since=0 ;; esac
  now=$(date +%s)
  [ "$since" != 0 ] || since=$now
  echo $(( (now - since) / 86400 ))
}

# lock_pid <dir>: the pid of a live `take_lock` holder, empty when the lock is free.
lock_pid() {
  local pid
  pid=$(cat "$1/pid" 2>/dev/null || true)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
}

# wt_busy <branch>: 0 when a live dangle is working in the worktree (a plan claim, the merge
# queue, a landing), when it has uncommitted changes, or when it is the one we stand in.
# Pruning never touches a worktree someone is using.
wt_busy() {
  local branch="$1" id path
  path=$(wt_path "$branch")
  case "$(pwd -P)/" in "$path"/*) return 0 ;; esac
  case $branch in
    "$PREFIX"*) id=${branch#"$PREFIX"}
      [ -z "$(lock_pid "$STATE/claims/$id")" ] || return 0 ;;
  esac
  [ "$branch" != "$QUEUE_BRANCH" ] || [ -z "$(lock_pid "$STATE/queue.lock")" ] || return 0
  [ -z "$(lock_pid "$STATE/land.lock")" ] || return 0
  [ -z "$(git -C "$path" status --porcelain --untracked-files=no 2>/dev/null)" ] || return 0
  return 1
}

# wt_branches: the branches of the worktrees under WORKTREES, one per line.
wt_branches() {
  git worktree list --porcelain | awk -v p="$PRIMARY/$WORKTREES/" '
    /^worktree / { w = substr($0, 10) }
    /^branch / { b = substr($0, 19); if (index(w, p) == 1) print b }'
}

# prune_worktree <branch> <days> <reason>: the project's prune hook in the worktree. What is
# disposable is the project's business (build output, caches); housekeeping never fails a run.
prune_worktree() {
  local branch="$1" path
  path=$(wt_path "$branch")
  export_ctx "$path" "$branch"
  DANGLE_PRUNE_DAYS="$2" DANGLE_PRUNE_REASON="$3"
  export DANGLE_PRUNE_DAYS DANGLE_PRUNE_REASON
  hook prune "$path" "$2" || err "the prune hook failed in $path (going on)"
  return 0
}

# prune_all <days> <max-gb> <dry> <all> <rm> <measure>: run the prune hook in every worktree
# dangle is not using that is idle for <days> days, over <max-gb> GB (0: no cap), or all of
# them (<all>). <rm> also removes a plan worktree with no commits of its own. <measure> adds
# sizes and the space freed to the output (a du pass per worktree).
prune_all() {
  local days="$1" maxg="$2" dry="$3" all="$4" rm="$5" measure="$6"
  local branch path ahead kb after reason pruned=0 removed=0 freed=0 over
  has_hook prune || [ "$rm" = 1 ] || return 0
  over=$((maxg * 1048576))
  for branch in $(wt_branches); do
    path=$(wt_path "$branch")
    [ -d "$path" ] || continue
    if wt_busy "$branch"; then
      [ "$all" = 0 ] || say "  skip     $branch (in use, or it has changes)"
      continue
    fi
    ahead=$(git rev-list --count "refs/heads/$BASE..refs/heads/$branch" 2>/dev/null || echo 0)
    kb=0
    if [ "$measure" = 1 ] || [ "$maxg" != 0 ]; then kb=$(wt_kb "$path"); fi
    reason=''
    if [ "$all" = 1 ]; then reason=all
    elif [ "$(wt_idle_days "$branch")" -ge "$days" ]; then reason=idle
    elif [ "$maxg" != 0 ] && [ "$kb" -ge "$over" ]; then reason=size
    fi
    [ -n "$reason" ] || continue
    # Nothing committed and nothing in progress: --rm drops the whole worktree, not just its
    # build output. A worktree of your own (not a plan's) is never removed.
    if [ "$rm" = 1 ] && [ "$ahead" = 0 ]; then
      case $branch in
        "$PREFIX"*)
          # Untracked files would go with it: leave a worktree that still holds any.
          if [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
            [ "$all" = 0 ] || say "  skip     $branch (untracked files)"
            continue
          fi
          if [ "$dry" = 1 ]; then
            say "  would remove $branch (no commits of its own)"
          elif remove_worktree "$branch"; then
            removed=$((removed + 1))
            [ "$measure" = 0 ] || freed=$((freed + kb))
            say "  removed  $branch"
          fi
          continue ;;
      esac
    fi
    if [ "$dry" = 1 ]; then
      if [ "$measure" = 0 ]; then
        say "  would prune $branch ($reason)"
      else
        say "  would prune $branch ($reason, $(human_kb "$kb"))"
      fi
      continue
    fi
    has_hook prune || continue
    if [ "$measure" = 1 ]; then
      say "  pruning  $branch ($reason, $(human_kb "$kb"))"
    else
      say "  pruning  $branch ($reason)"
    fi
    prune_worktree "$branch" "$days" "$reason"
    pruned=$((pruned + 1))
    if [ "$measure" = 1 ]; then after=$(wt_kb "$path"); freed=$((freed + kb - after)); fi
  done
  if [ "$pruned" = 0 ] && [ "$removed" = 0 ]; then return 0; fi
  if [ "$measure" = 1 ]; then
    say "  pruned $pruned worktree(s), removed $removed, freed $(human_kb "$freed")"
  else
    say "  pruned $pruned worktree(s), removed $removed"
  fi
}

# prune_auto: housekeeping around a run: worktrees idle for PRUNE_DAYS days or over
# PRUNE_MAX_GB are pruned; nothing is removed.
prune_auto() {
  if [ "${PRUNE_DAYS:-0}" = 0 ] && [ "${PRUNE_MAX_GB:-0}" = 0 ]; then return 0; fi
  has_hook prune || return 0
  prune_all "$PRUNE_DAYS" "$PRUNE_MAX_GB" 0 0 0 "$(if [ "$PRUNE_MAX_GB" != 0 ]; then echo 1; else echo 0; fi)"
}

# on_base <branch>: the branch has work of its own, and all of it is on the base branch already:
# landed by hand (merged, fast-forwarded, squashed or cherry-picked) after a failed run. Nothing
# is left for an agent but the plan file to retire. Branches made before dangle recorded where
# they started fall back to the branch's reflog.
on_base() {
  local tip fork tree
  tip=$(git rev-parse -q --verify "refs/heads/$1") || return 1
  fork=$(git config "branch.$1.danglebase" 2>/dev/null ||
    git reflog show --format=%H "refs/heads/$1" 2>/dev/null | tail -n 1)
  [ -n "$fork" ] && [ "$tip" != "$fork" ] || return 1
  # Merging the branch into the base branch would change nothing.
  tree=$(git merge-tree --write-tree "refs/heads/$BASE" "$tip" 2>/dev/null | head -n 1)
  [ -n "$tree" ] && [ "$tree" = "$(git rev-parse "refs/heads/$BASE^{tree}")" ]
}

# ---------------------------------------------------------------- plans

plan_files() {
  local f
  for f in "$PRIMARY/$PLANS"/*.md; do
    [ -f "$f" ] || continue
    case ${f##*/} in README.md|readme.md|INDEX.md) continue ;; esac
    printf '%s\n' "$f"
  done
}

# The id of a plan file: its number (2026-10-14-865-name.md and 865-name.md are 865), or
# without one, its name without a leading date.
plan_id() {
  basename "$1" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//; s/^([0-9]+)(-.*)?$/\1/'
}
# A plan file can vanish mid-run (another dangle landed it): the readers then say nothing.
plan_title() { [ -f "$1" ] || return 0; sed -n 's/^#[[:space:]]*//p' "$1" | head -n 1; }
# plan_field <file> <key>: from the header comment `<!-- dangle: depends=1,2 agent=claude:sonnet -->`
plan_field() {
  [ -f "$1" ] || return 0
  sed -n 's/.*<!--[[:space:]]*dangle:\(.*\)-->.*/\1/p' "$1" | head -n 1 | tr ' ' '\n' |
    sed -n "s/^$2=//p" | head -n 1
}
plan_done_when() { [ -f "$1" ] || return 0; sed -n 's/^[*_]*Done when:[*_]*[^`]*`\([^`]*\)`.*/\1/p' "$1" | head -n 1; }

# Ids of plans landed on the base branch: the files in <plans>/<done>/ there.
# Cached per commit of the base branch: a run asks this for every plan, again and again.
landed_ids() {
  local sha cache
  if [ "$PRIVATE" = 1 ]; then
    ls "$PRIMARY/$PLANS/$DONE" 2>/dev/null | sed -n 's/\.md$//p' |
      sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//; s/^([0-9]+)(-.*)?$/\1/'
    return 0
  fi
  sha=$(git rev-parse -q --verify "refs/heads/$BASE") || return 0
  cache="$STATE/landed-$sha"
  if [ ! -f "$cache" ]; then
    git ls-tree --name-only "refs/heads/$BASE" -- "$PLANS/$DONE/" 2>/dev/null |
      sed -n 's|.*/||; s/\.md$//p' |
      sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//; s/^([0-9]+)(-.*)?$/\1/' > "$cache.$$" &&
      mv "$cache.$$" "$cache"
  fi
  cat "$cache"
}
# is_id <id> <name>: an id names a plan when it is the plan's id or its first words
# (`shop-A1` names `shop-A1-report-links`, never `shop-A10-guides`).
is_id() { [ "$2" = "$1" ] || case $2 in "$1"-*) true ;; *) false ;; esac; }
is_landed() {
  landed_ids | awk -v d="$1" '$0 == d || index($0, d "-") == 1 { f = 1 } END { exit !f }'
}

# find_plan <id or part of a name>: the active plan file.
find_plan() {
  local want="$1" f hits='' n=0
  for f in $(plan_files); do
    [ "$(plan_id "$f")" = "$want" ] && { printf '%s' "$f"; return 0; }
  done
  for f in $(plan_files); do
    is_id "$want" "$(plan_id "$f")" && { hits="$hits $f"; n=$((n + 1)); }
  done
  [ $n = 1 ] && { printf '%s' "${hits# }"; return 0; }
  hits='' n=0
  for f in $(plan_files); do
    case ${f##*/} in *"$want"*) hits="$hits $f"; n=$((n + 1)) ;; esac
  done
  [ $n = 1 ] && { printf '%s' "${hits# }"; return 0; }
  [ $n = 0 ] && return 1
  err "'$want' matches $n plans:$hits"
  return 2
}

# unmet <file> [ids taken as landed]: the dependencies of a plan that have not landed.
unmet() {
  local d
  local a
  for d in $(plan_field "$1" depends | tr ',' ' '); do
    for a in ${2-}; do is_id "$d" "$a" && continue 2; done
    is_landed "$d" || printf '%s\n' "$d"
  done
}

# first_ready <files> [ids taken as landed]: the first plan, in order, whose dependencies landed.
first_ready() {
  local g
  for g in $1; do
    [ -z "$(unmet "$g" "${2-}")" ] && { printf '%s' "$g"; return 0; }
  done
  return 1
}
# running_elsewhere <id>: another live dangle has claimed the plan.
running_elsewhere() {
  local c pid
  for c in "$STATE"/claims/*; do
    [ -d "$c" ] && is_id "$1" "${c##*/}" || continue
    pid=$(cat "$c/pid" 2>/dev/null) || continue
    [ -n "$pid" ] && [ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null && return 0
  done
  # Another computer's run (REMOTE_CLAIMS=1).
  claim_host "$1" > /dev/null
}

# first_runnable <files>: first_ready, plus (PIPELINE) the first plan that waits only for one
# plan landing here: it starts on that plan's branch (stack_parent).
first_runnable() {
  local g
  for g in $1; do
    [ -z "$(unmet "$g")" ] && { printf '%s' "$g"; return 0; }
    [ -n "$(stack_parent "$g")" ] && { printf '%s' "$g"; return 0; }
  done
  return 1
}

# stack_parent <file>: with PIPELINE, the id of the one plan this plan still waits for, when
# that plan's agent has finished here and it is landing (its branch can be built on).
stack_parent() {
  local u r b
  [ "$PIPELINE" -gt 0 ] || return 0
  u=$(unmet "$1")
  [ -n "$u" ] && [ "$(printf '%s\n' "$u" | wc -l | tr -d ' ')" = 1 ] || return 0
  b="$PREFIX$(plan_id "$1")"
  for r in "$STATE"/ready/*; do
    [ -f "$r" ] && is_id "$u" "${r##*/}" && ready_live "${r##*/}" || continue
    # A kept worktree is continued as it is: only one started on this parent may go on.
    if [ -d "$(wt_path "$b")" ] && [ "${FRESH:-0}" = 0 ] &&
      [ "$(git config "branch.$b.dangleparent" 2>/dev/null)" != "${r##*/}" ]; then
      return 0
    fi
    printf '%s' "${r##*/}"
    return 0
  done
  return 0
}

# wait_parent <branch>: a plan started on another plan's branch (PIPELINE) lands after it. 1
# (with FAIL_REASON) when that plan stopped without landing.
wait_parent() {
  local p said=''
  p=$(git config "branch.$1.dangleparent" 2>/dev/null) || return 0
  [ -n "$p" ] || return 0
  while :; do
    synced
    if is_landed "$p"; then git config --unset "branch.$1.dangleparent"; return 0; fi
    if ! ready_live "$p"; then
      # It may have landed between the two looks.
      synced
      is_landed "$p" && { git config --unset "branch.$1.dangleparent"; return 0; }
      fail "it was started on $p's branch, and $p did not land (land $p, then this plan again; --fresh starts it over)"
      return 1
    fi
    [ -n "$said" ] || { say "  land   waiting for $p to land first"; said=1; }
    sleep "${DANGLE_POLL:-30}"
  done
}

without() { printf '%s\n' "$1" | grep -Fxv -- "$2"; }
# mine <files>: those no other live dangle is running.
mine() {
  local g
  for g in $1; do running_elsewhere "$(plan_id "$g")" || printf '%s\n' "$g"; done
}

# ---------------------------------------------------------------- prompts

DEFAULT_PROMPT='You are working in a git worktree of this repository, on branch {{branch}}.

Implement the plan in {{plan}}. Read it in full first, then follow the repository'"'"'s own
instructions and conventions (for example AGENTS.md, CLAUDE.md, CONTRIBUTING.md, README,
and any files the plan names).

- Commit your work on this branch as you go, new files too, following the repository'"'"'s
  commit style. Earlier work may already be committed here: continue from it.
- Do only this plan: what it leaves to another plan stays out.
- A failure your change only nudges (a stack overflow, a timeout, a flaky test): give it 30
  minutes at most, then commit and say what you found in your last message.
- Build no second checkout or copy of the repository.
- Do not merge, push, rebase, switch branches, or move or edit the plan file. An automated
  runner integrates this branch after you finish, and only if the project'"'"'s checks pass.
- Before you stop, run the project'"'"'s checks and make them pass: {{gate}}
- If the plan is ambiguous, choose the smallest reasonable interpretation and note it.
- If the plan cannot be done as written, commit what is safe and say why in your last message.'

DEFAULT_FIX_PROMPT='The project'"'"'s checks failed for the work on branch {{branch}}, which implements the plan in {{plan}}.

The end of the checks'"'"' output is below; all of it is in {{gate_log}}.
Find the cause, fix it, commit, and stop. Run the checks again to verify: {{gate}}
Do not merge, push, or edit the plan file.

{{gate_tail}}'

DEFAULT_MERGE_PROMPT='Merging {{base}} into branch {{branch}}, which implements the plan in {{plan}}, stopped on
conflicts. The merge is in progress in this worktree (see git status); the conflicted files are:
{{conflicts}}

Resolve every conflict so both sides'"'"' work survives. {{base}} has already landed, so its names
and shapes win: adapt this branch'"'"'s side to them. Then git add the files and finish the merge with
git commit --no-edit, and run the project'"'"'s checks: {{gate}}
Do not abort the merge, rebase, push, or edit the plan file.'

DEFAULT_AUDIT_PROMPT='Do not change, create or delete any file, and do not commit: this is a read-only check.

Read the implementation plan in {{plan}}. Then look at this repository'"'"'s code, tests and git log
to decide how much of the plan is already done.

End your reply with exactly one line, the last line:
DANGLE-AUDIT: done            (every task of the plan is already in the code)
DANGLE-AUDIT: partial <what is still missing, in a few words>
DANGLE-AUDIT: todo            (little or none of it is done)'

# render <template text>: fills {{name}} from DANGLE_T_name.
render() {
  printf '%s\n' "$1" | awk '{
    line = $0; out = ""
    while ((i = index(line, "{{")) > 0) {
      j = index(substr(line, i + 2), "}}"); if (!j) break
      name = substr(line, i + 2, j - 1); key = "DANGLE_T_" name
      out = out substr(line, 1, i - 1) ((key in ENVIRON) ? ENVIRON[key] : "{{" name "}}")
      line = substr(line, i + j + 3)
    }
    print out line }'
}
template() { if [ -f "$DOT/$1" ]; then cat "$DOT/$1"; else printf '%s' "$2"; fi; }

gate_desc() {
  if has_hook gate; then printf '.dangle/hooks/gate'; else printf '(no gate: .dangle/hooks/gate is missing)'; fi
}

# run_agent <spec> <worktree> <log> <prompt>
run_agent() {
  local spec="$1" dir="$2" log="$3" prompt="$4" tailer='' rc
  resolve_agent "$spec" "$(cfg AGENT)"
  say "  agent  $AGENT_LABEL  (log $log)"
  printf '\n=== %s  %s ===\n' "$(date)" "$AGENT_LABEL" >> "$log"
  # Where this session starts in the log and the event stream, for not_run_reason.
  AGENT_LOG_OFF=$(wc -c < "$log" | tr -d ' ')
  AGENT_JSONL_OFF=0
  [ ! -f "${log%.log}.jsonl" ] || AGENT_JSONL_OFF=$(wc -c < "${log%.log}.jsonl" | tr -d ' ')
  if [ "${FOLLOW:-0}" = 1 ]; then tail -n 0 -f "$log" & tailer=$!; else heartbeat agent "$log"; fi
  rm -f "$log.stalled"
  stall_watch "$dir" "$log"
  (
    cd "$dir" || exit 1
    set -f; set -- $AGENT_CMD; set +f
    DANGLE=1 DANGLE_MODEL=${AGENT_LABEL#*:}; export DANGLE DANGLE_MODEL
    # No one is there to type: a `git commit --amend` or `rebase` must not wait in an editor,
    # nor a push or fetch at a password prompt.
    GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true GIT_TERMINAL_PROMPT=0 GIT_PAGER=cat
    export GIT_EDITOR GIT_SEQUENCE_EDITOR GIT_TERMINAL_PROMPT GIT_PAGER
    # The raw event stream goes to <log>.jsonl; the log itself gets one readable line per step.
    { run_limited "$AGENT_SECS" "$@" "$prompt" < /dev/null 2>&1; echo $? > "$log.rc"; } |
      tee -a "${log%.log}.jsonl" | readable >> "$log"
    exit "$(cat "$log.rc" 2>/dev/null || echo 1)"
  )
  rc=$?
  AGENT_RC=$rc
  rm -f "$log.rc"
  stop_heartbeat
  stop_stall_watch
  [ -n "$tailer" ] && kill "$tailer" 2>/dev/null
  if [ -f "$log.stalled" ]; then
    rm -f "$log.stalled"
    say "  agent  stopped: no new commit in $(cfg STALL_TIMEOUT 60m)"
    printf 'dangle: stopped, no new commit in %s\n' "$(cfg STALL_TIMEOUT 60m)" >> "$log"
  elif [ $rc = 124 ]; then
    say "  agent  stopped after $(cfg AGENT_TIMEOUT 4h)"
  fi
  return $rc
}

# agent_said <log>: the last line the agent wrote in its latest session in the log, for a reason.
agent_said() {
  awk '/^=== .* ===$/ { last = "" } NF { if ($0 !~ /^=== /) last = $0 } END { print last }' "$1"
}

# The errors of a provider or a sign-in, not of the work: the model is overloaded or down, the
# account is out of credit or usage, the key is wrong, the network is gone.
PROVIDER_ERRORS='(^|[^0-9])(401|403|408|429|500|502|503|504|529)([^0-9]|$)|overloaded|rate.?limit|too many requests|quota|usage limit|credit|billing|insufficient|unavailable|bad gateway|gateway time|unauthori[sz]ed|forbidden|api.?key|authenticat|log ?in|connection (refused|reset|error)|timed? ?out|network|ECONN|ENOTFOUND|EAI_AGAIN'

# not_run_reason <log>: after run_agent, when the agent's latest session did no work (no tool
# call in the log) and failed in a way that is not the plan's, prints `provider <error>` (the
# model or account: worth trying again later) or `agent <words>` (it exited with an error: a
# bad flag, a missing command) and succeeds. A session that worked, or exited 0 having said
# nothing about an error, is the plan's to answer for: it fails. The caller has checked that
# there are no commits.
not_run_reason() {
  local log="$1" new err
  new=$(tail -c +$((AGENT_LOG_OFF + 1)) "$log" 2>/dev/null)
  printf '%s\n' "$new" | grep -q '^→ ' && return 1
  # An error line from the agent (pi: `error: 429 …`, claude: `API Error: 529 …`, codex: `ERROR: …`),
  # or the final error in its event stream.
  err=$(printf '%s\n' "$new" | grep -iE '^[[:space:]]*(\[?(api )?error\]?|fatal)[]: ]' |
    grep -iE "$PROVIDER_ERRORS" | tail -n 1)
  if [ -z "$err" ]; then
    err=$(tail -c +$((AGENT_JSONL_OFF + 1)) "${log%.log}.jsonl" 2>/dev/null |
      grep -E '"finalError":"|"is_error":true' |
      sed -n -e 's/.*"finalError":"\([^"\\]*\(\\.[^"\\]*\)*\)".*/\1/p' \
        -e 't' \
        -e 's/.*"is_error":true.*"result":"\([^"\\]*\(\\.[^"\\]*\)*\)".*/\1/p' |
      sed 's/\\"/"/g' | tail -n 1)
  fi
  if [ -n "$err" ]; then
    printf 'provider %s\n' "$(printf '%s' "$err" | sed 's/^[[:space:]]*//' | cut -c1-300)"
  elif [ "${AGENT_RC:-0}" != 0 ]; then
    printf 'agent exited %s: %s\n' "$AGENT_RC" "$(agent_said "$log" | cut -c1-300)"
  else
    return 1
  fi
}

# fix_up <fix spec> <worktree> <log>: a fix-up after a failed gate. An agent that exits with an
# error and changes nothing (a bad flag, a model that is down) fails the landing with its own
# words, instead of the gate running again on the same work.
fix_up() {
  local before rc=0
  before=$(git -C "$2" rev-parse HEAD)
  run_agent "$1" "$2" "$3" "$(render "$(template fix-prompt.md "$DEFAULT_FIX_PROMPT")")" || rc=$?
  commit_leftovers "$2"
  if [ $rc != 0 ] && [ "$(git -C "$2" rev-parse HEAD)" = "$before" ]; then
    fail "the fix agent exited $rc and changed nothing: $(agent_said "$3")"; return 1
  fi
}

# commit_leftovers <worktree>: an agent that forgot to commit still gets its work gated.
commit_leftovers() {
  [ -n "$(git -C "$1" status --porcelain)" ] || return 0
  git -C "$1" add -A && git -C "$1" commit -q -m "dangle: work the agent left uncommitted"
}

# ---------------------------------------------------------------- the gate

# run_gate <worktree> <log> [plan file]: the gate hook, then the plan's `Done when:` command.
run_gate() {
  local dir="$1" log="$2" plan="${3-}" dw rc
  printf '=== gate %s ===\n' "$(date)" > "$log"
  if has_hook gate; then
    heartbeat gate "$log"
    run_limited "$GATE_SECS" sh -c 'cd "$1" && DANGLE_HOOK=gate exec "$2"' sh "$dir" "$HOOKS/gate" >> "$log" 2>&1
    rc=$?
    stop_heartbeat
    [ $rc = 124 ] && echo "dangle: the gate ran longer than $(cfg GATE_TIMEOUT 60m)" >> "$log"
    [ $rc = 0 ] || return 1
  else
    echo "dangle: no .dangle/hooks/gate; nothing checked" >> "$log"
  fi
  if [ -n "$plan" ]; then
    dw=$(plan_done_when "$plan")
    if [ -n "$dw" ]; then
      printf '=== done when: %s ===\n' "$dw" >> "$log"
      ( cd "$dir" && sh -c "$dw" ) >> "$log" 2>&1 || return 1
    fi
  fi
}

regate_needed() { # <old base> <new base>
  has_hook regate || return 0
  hook regate "$DANGLE_WORKTREE" "$1" "$2"
}

# ---------------------------------------------------------------- landing

FAIL_REASON=
fail() { FAIL_REASON=$1; return 1; }

# done_on_disk <plan file>: a private plan that landed moves to the done folder.
done_on_disk() {
  mkdir -p "$PRIMARY/$PLANS/$DONE" && mv "$PRIMARY/$PLANS/${1##*/}" "$PRIMARY/$PLANS/$DONE/"
}

# settle_added <worktree>: in a conflicted merge, settles the conflicts where both sides only
# added lines at the same place (two plans appending to one list, match or doc section): the
# base's lines first, as they landed first, then the branch's. The gate still runs after. Any
# other conflict (a line both sides changed, a deleted file) leaves the merge for an agent or you,
# and so does a branch line the base branch also added to that file: both plans added the same
# entry, and keeping both sides would list it twice.
settle_added() {
  local dir="$1" files f n=0 total=0 sides="$STATE/settle.$$"
  files=$(git -C "$dir" diff --name-only --diff-filter=U)
  [ -n "$files" ] || return 1
  while IFS= read -r f; do
    # A content conflict has all three stages; add/add, delete/modify and the like do not.
    [ "$(git -C "$dir" ls-files -u -- "$f" | wc -l)" -eq 3 ] || return 1
    git -C "$dir" checkout -q --conflict=diff3 -- "$f" 2>/dev/null || return 1
    git -C "$dir" show ":1:$f" > "$sides.1" && git -C "$dir" show ":3:$f" > "$sides.3" || return 1
    n=$(awk '
      FILENAME == f1 { before[$0] = 1; next }
      FILENAME == f3 { landed[$0] = 1; next }
      /^<<<<<<< / && s == 0 { s = 1; ours = ""; theirs = ""; next }
      /^\|\|\|\|\|\|\| / && s == 1 { s = 2; next }
      /^=======$/ && s == 2 { s = 3; next }
      /^>>>>>>> / && s == 3 { printf "%s%s", theirs, ours > out; s = 0; n++; next }
      s == 1 { ours = ours $0 "\n"; if ($0 ~ /[^ \t]/ && ($0 in landed) && !($0 in before)) bad = 1; next }
      s == 2 { bad = 1; next }
      s == 3 { theirs = theirs $0 "\n"; next }
      { print > out }
      END { if (bad || s || !n) exit 1; print n }' \
      f1="$sides.1" f3="$sides.3" out="$dir/$f.dangle-settled" "$sides.1" "$sides.3" "$dir/$f") ||
      { rm -f "$dir/$f.dangle-settled" "$sides.1" "$sides.3"; return 1; }
    rm -f "$sides.1" "$sides.3"
    total=$((total + n))
  done <<FILES
$files
FILES
  printf '%s\n' "$files" | while IFS= read -r f; do mv "$dir/$f.dangle-settled" "$dir/$f"; done
  printf '%s\n' "$files" | (cd "$dir" && while IFS= read -r f; do git add -- "$f"; done)
  [ -z "$(git -C "$dir" diff --name-only --diff-filter=U)" ] &&
    git -C "$dir" commit -q --no-edit || return 1
  say "  merge  settled $total conflict(s) where both sides added lines: $(printf '%s' "$files" | tr '\n' ' ')"
}

# merge_by_agent <worktree> <agent spec> <log> <commit before the merge>: the agent resolves the
# merge in progress. It counts only when the merge is committed with no conflict marker left.
merge_by_agent() {
  local dir="$1" before="$4" rc=0
  DANGLE_T_conflicts=$(git -C "$dir" diff --name-only --diff-filter=U | sed 's/^/- /')
  DANGLE_T_base=$BASE; export DANGLE_T_conflicts DANGLE_T_base
  say "  merge  conflicts with $BASE; the agent resolves them"
  run_agent "$2" "$dir" "$3" "$(render "$(template merge-prompt.md "$DEFAULT_MERGE_PROMPT")")" || rc=$?
  if [ -n "$(git -C "$dir" diff --name-only --diff-filter=U)" ]; then
    [ $rc = 0 ] || MERGE_WHY="the agent exited $rc and left them: $(agent_said "$3")"
    return 1
  fi
  if git -C "$dir" rev-parse -q --verify MERGE_HEAD >/dev/null; then
    git -C "$dir" add -A && git -C "$dir" commit -q --no-edit || return 1
  fi
  commit_leftovers "$dir"
  git merge-base --is-ancestor "refs/heads/$BASE" "$(git -C "$dir" rev-parse HEAD)" || return 1
  ! git -C "$dir" diff --check "$before" HEAD 2>/dev/null | grep -q 'leftover conflict marker'
}

# merge_base_in <worktree> <interactive> [agent spec] [log]: merges the base branch into the
# worktree's branch. A conflict where both sides added lines is settled by itself; any other one
# goes to the agent, when one is given, or stops (by hand: with the merge left for you).
# MERGED_BY says who settled it: empty (a clean merge), auto or agent. MERGE_WHY says why the
# agent did not, when it failed rather than gave up.
MERGED_BY=
MERGE_WHY=
merge_base_in() {
  local dir="$1" before
  MERGED_BY='' MERGE_WHY=''
  before=$(git -C "$dir" rev-parse HEAD)
  git -C "$dir" merge -q --no-edit "refs/heads/$BASE" >/dev/null 2>&1 && return 0
  if settle_added "$dir"; then MERGED_BY=auto; return 0; fi
  if [ "${2-}" = 1 ]; then
    err "the merge of $BASE into $1 conflicts: resolve it there, commit, and run dangle land again"
    return 1
  fi
  if [ -n "${3-}" ] && merge_by_agent "$dir" "$3" "$4" "$before"; then MERGED_BY=agent; return 0; fi
  git -C "$dir" merge --abort 2>/dev/null
  git -C "$dir" reset -q --hard "$before"
  return 1
}

# merge_spending_fixes: land()'s merge of the base branch; an agent resolving a conflict spends
# one of the FIXES fix-ups. Reads and sets land()'s locals (path, inter, fix, alog, fixes).
merge_spending_fixes() {
  local spare=''
  [ "$fixes" -lt "$FIXES" ] && spare=$fix
  merge_base_in "$path" "$inter" "$spare" "$alog" ||
    { fail "conflicts with $BASE${MERGE_WHY:+ ($MERGE_WHY)}"; return 1; }
  [ "$MERGED_BY" != agent ] || fixes=$((fixes + 1))
}

# ---------------------------------------------------------------- the merge queue

# QUEUE=batch. A landing that is ready to gate (the base branch merged in, the plan moved to the
# done folder) submits its branch to the queue and waits. Whichever waiting landing holds
# queue.lock drives the queue: it merges every branch waiting into one worktree that stays (the
# queue worktree, branch QUEUE_BRANCH, so its build output stays warm), runs the gate once on
# all of them, and lands each as its own squashed commit. A batch that fails is split in half
# and each half gated again, down to the branch that broke it; that branch gets its gate log
# back for a fix-up. A branch that conflicts with another in the batch is handed back to merge
# the base branch again. One gate at a time on the whole machine, instead of one per runner,
# and no second gate when another runner lands first.
#
# An entry is a directory in $STATE/queue: branch, title, plan, log, nogate, pid; the driver
# writes result (landed <sha>, failed, conflict, empty, again). Entries of dead processes are
# dropped. A `--no-gate` entry lands in a batch of its own, ungated.

QUEUE_ENTRY=
QW=
QBASE=
QBUILT=

# queue_submit <branch> <plan file or empty> <title or empty> <gate log> <nogate>: prints the entry.
queue_submit() {
  local e
  e="$STATE/queue/$(date +%s).$$.$(printf '%s' "$1" | tr '/' '_')"
  mkdir -p "$e"
  printf '%s\n' "$1" > "$e/branch"
  printf '%s\n' "$2" > "$e/plan"
  printf '%s\n' "$3" > "$e/title"
  printf '%s\n' "$4" > "$e/log"
  [ -z "$5" ] || : > "$e/nogate"
  echo $$ > "$e/pid"
  printf '%s' "$e"
}

queue_result() { printf '%s\n' "$2" > "$1/result.tmp" && mv "$1/result.tmp" "$1/result"; }

# queue_wait <entry>: until the entry has a result. When nobody drives the queue, this landing
# does.
queue_wait() {
  local e="$1" pid said=''
  while [ ! -f "$e/result" ]; do
    if mkdir "$STATE/queue.lock" 2>/dev/null; then
      echo $$ > "$STATE/queue.lock/pid"
      queue_cycle
      drop_lock "$STATE/queue.lock"
      continue
    fi
    pid=$(cat "$STATE/queue.lock/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then rm -rf "$STATE/queue.lock"; continue; fi
    [ -n "$said" ] || { say "  queue  waiting for the batch being gated${pid:+ (pid $pid)}"; said=1; }
    sleep "${DANGLE_QUEUE_POLL:-3}"
  done
}

# queue_entries: the waiting entries, oldest first; those of dead processes are removed.
queue_entries() {
  local e pid
  for e in "$STATE"/queue/*; do
    [ -d "$e" ] && [ -f "$e/pid" ] && [ ! -f "$e/result" ] || continue
    pid=$(cat "$e/pid")
    kill -0 "$pid" 2>/dev/null || { rm -rf "$e"; continue; }
    printf '%s\n' "$e"
  done
}

# queue_cycle: one turn of the queue, every entry waiting now. Ungated entries first.
queue_cycle() {
  local all e nogate='' gated=''
  all=$(queue_entries)
  [ -n "$all" ] || return 0
  for e in $all; do
    if [ -f "$e/nogate" ]; then nogate="$nogate $e"; else gated="$gated $e"; fi
  done
  QW=$(wt_path "$QUEUE_BRANCH")
  if [ ! -d "$QW" ]; then
    say "  queue  creating the queue worktree $QW"
    if ! new_worktree "$QUEUE_BRANCH" "$BASE"; then
      for e in $all; do
        echo "dangle: could not create the queue worktree $QW" > "$(cat "$e/log")"
        queue_result "$e" failed
      done
      return 0
    fi
  fi
  synced
  if [ -n "$nogate" ]; then
    # shellcheck disable=SC2086
    queue_build $nogate || for e in $nogate; do queue_result "$e" again; done
    [ -n "$QBUILT" ] && {
      say "  queue  landing without the gate:$(queue_names $QBUILT)"
      queue_push nogate $QBUILT
    }
  fi
  # shellcheck disable=SC2086
  [ -z "$gated" ] || queue_gate $gated
}

queue_names() { local e; for e; do printf ' %s' "$(cat "$e/branch")"; done; }

# queue_build <entries>: the queue worktree at the base branch with each entry's branch merged in,
# in order; each entry's tree is the result up to it. A branch that does not merge (other than
# lines both sides added, settled as on landing) is handed back. Sets QBASE and QBUILT.
queue_build() {
  local e b
  QBUILT=
  git -C "$QW" merge --abort 2>/dev/null
  git -C "$QW" reset -q --hard "refs/heads/$BASE" && git -C "$QW" clean -fdq || return 1
  QBASE=$(git rev-parse "refs/heads/$BASE")
  for e; do
    b=$(cat "$e/branch")
    if git -C "$QW" merge -q --no-edit "refs/heads/$b" >/dev/null 2>&1 || settle_added "$QW"; then
      git -C "$QW" rev-parse 'HEAD^{tree}' > "$e/tree"
      QBUILT="$QBUILT $e"
    else
      git -C "$QW" merge --abort 2>/dev/null
      git -C "$QW" reset -q --hard HEAD
      say "  queue  $b conflicts with a branch ahead of it; handed back"
      queue_result "$e" conflict
    fi
  done
}

# queue_checks <log> <entries>: the gate, then each plan's `Done when:` command, in the queue
# worktree.
queue_checks() {
  local log="$1" e p dw
  shift
  run_gate "$QW" "$log" '' || return 1
  for e; do
    p=$(cat "$e/plan")
    [ -n "$p" ] || continue
    dw=$(plan_done_when "$p")
    [ -n "$dw" ] || continue
    printf '=== done when (%s): %s ===\n' "$(cat "$e/branch")" "$dw" >> "$log"
    ( cd "$QW" && sh -c "$dw" ) >> "$log" 2>&1 || return 1
  done
}

# queue_gate <entries>: builds, gates and lands them; a failed batch is split in half.
queue_gate() {
  local log="$STATE/logs/queue.gate.log" e i=0 half first='' second=''
  if ! queue_build "$@"; then
    for e; do queue_result "$e" again; done
    return 0
  fi
  # shellcheck disable=SC2086
  set -- $QBUILT
  [ $# -gt 0 ] || return 0
  say "  queue  gating $# branch(es):$(queue_names "$@") (log $log)"
  export_ctx "$QW" "$QUEUE_BRANCH"
  if queue_checks "$log" "$@"; then
    queue_push gated "$@"
    return 0
  fi
  if [ $# = 1 ]; then
    cp "$log" "$(cat "$1/log")"
    say "  queue  the gate failed for$(queue_names "$1")"
    queue_result "$1" failed
    return 0
  fi
  half=$((($# + 1) / 2))
  for e; do
    i=$((i + 1))
    if [ $i -le $half ]; then first="$first $e"; else second="$second $e"; fi
  done
  say "  queue  the batch failed; gating each half"
  # shellcheck disable=SC2086
  queue_gate $first
  # shellcheck disable=SC2086
  queue_gate $second
}

# queue_message <entry> <base sha>: the squashed commit's message, as land() writes it.
queue_message() {
  local e="$1" b msg
  b=$(cat "$e/branch"); msg=$(cat "$e/title")
  if [ -z "$msg" ] && [ "$(git rev-list --no-merges --count "$2..refs/heads/$b")" = 1 ]; then
    msg=$(git log --no-merges -1 --format=%s "$2..refs/heads/$b")
  fi
  [ -n "$msg" ] || msg=$b
  printf '%s\n\nLanded by dangle from %s.\n\n' "$msg" "$b"
  git log --no-merges --format='- %s' "$2..refs/heads/$b" | grep -v '^- dangle: '
}

# queue_push <gated|nogate> <entries>: under the land lock, one squashed commit per entry on the
# base branch, pushed together. When the base branch moved since the build, the batch is built
# again on it; a gated batch is gated again unless the regate hook says the move cannot matter.
queue_push() {
  local how="$1" tries=0 new old parent e t sha
  shift
  take_lock "$STATE/land.lock" "another landing"
  while :; do
    tries=$((tries + 1))
    if [ $tries -gt 3 ]; then
      drop_lock "$STATE/land.lock"
      for e; do queue_result "$e" again; done
      return 0
    fi
    sync_base
    new=$(git rev-parse "refs/heads/$BASE")
    if [ "$new" != "$QBASE" ]; then
      old=$QBASE
      queue_build "$@" || { drop_lock "$STATE/land.lock"; for e; do queue_result "$e" again; done; return 0; }
      if [ "$how" = gated ] && { [ "$QBUILT" != "$(printf ' %s' "$@")" ] || regate_needed "$old" "$new"; }; then
        drop_lock "$STATE/land.lock"
        say "  queue  $BASE moved; gating again"
        # shellcheck disable=SC2086
        queue_gate $QBUILT
        return 0
      fi
      # shellcheck disable=SC2086
      set -- $QBUILT
      [ $# -gt 0 ] || { drop_lock "$STATE/land.lock"; return 0; }
    fi
    parent=$new
    for e; do
      rm -f "$e/sha"
      t=$(cat "$e/tree")
      [ "$t" != "$(git rev-parse "$parent^{tree}")" ] || continue
      sha=$(queue_message "$e" "$new" | git commit-tree "$t" -p "$parent") ||
        { drop_lock "$STATE/land.lock"; for x; do queue_result "$x" again; done; return 0; }
      echo "$sha" > "$e/sha"
      parent=$sha
    done
    [ "$parent" != "$new" ] || break
    # Someone committed on the base branch meanwhile: take that in first.
    [ "$(git rev-parse "refs/heads/$BASE")" = "$new" ] || continue
    if [ -n "$REMOTE" ] && ! git push -q "$REMOTE" "$parent:refs/heads/$BASE" 2>/dev/null; then
      say "  queue  $REMOTE/$BASE moved during the landing; syncing again"
      continue
    fi
    advance_base "$parent" "$new"
    break
  done
  drop_lock "$STATE/land.lock"
  for e; do
    if [ -f "$e/sha" ]; then queue_result "$e" "landed $(cat "$e/sha")"; else queue_result "$e" empty; fi
  done
}

# queue_land: land()'s ending under QUEUE=batch; reads and sets land()'s locals. Submits the
# branch, waits for the queue, and on a failed gate or a conflict does what land() does: a
# fix-up or a merge of the base branch, then submits again.
queue_land() {
  local e result again=0
  while :; do
    e=$(queue_submit "$branch" "$wplan" "${plan:+$(plan_title "$wplan")}" "$log" "$NOGATE")
    QUEUE_ENTRY=$e
    say "  queue  submitted${NOGATE:+ (no gate)}"
    queue_wait "$e"
    result=$(cat "$e/result")
    rm -rf "$e"; QUEUE_ENTRY=
    export_ctx "$path" "$branch"
    case $result in
      landed*) sha=${result#landed }; break ;;
      empty) fail "nothing to land: the branch has no changes"; return 1 ;;
      again|conflict)
        again=$((again + 1))
        [ $again -le 3 ] || { fail "could not land with the queue ($result); try again"; return 1; }
        synced
        merge_spending_fixes || return 1 ;;
      *)
        if [ -z "$fix" ] || [ $fixes -ge "$FIXES" ]; then
          fail "the gate failed (log $log)"; return 1
        fi
        fixes=$((fixes + 1))
        say "  gate   failed; fix-up $fixes of $FIXES"
        DANGLE_T_gate_log=$log DANGLE_T_gate_tail=$(tail -n 80 "$log")
        export DANGLE_T_gate_log DANGLE_T_gate_tail
        fix_up "$fix" "$path" "$alog" || return 1
        synced
        merge_spending_fixes || return 1 ;;
    esac
  done
  [ -n "$plan" ] && [ "$PRIVATE" = 1 ] && done_on_disk "$plan"
  say "  land   $(git rev-parse --short "$sha") on $BASE${REMOTE:+ (pushed to $REMOTE)}"
  if [ -z "$keep" ]; then
    remove_worktree "$branch" force || err "landed, but the worktree $path was not removed"
  fi
  return 0
}

cmd_queue() {
  local e pid
  pid=$(cat "$STATE/queue.lock/pid" 2>/dev/null || true)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then say "driven by pid $pid"; else say "nobody drives the queue"; fi
  for e in $(queue_entries); do
    say "  $(cat "$e/branch")$( [ -f "$e/nogate" ] && echo ' (no gate)')  pid $(cat "$e/pid")"
  done
}

# land <branch> <plan file or empty> <fix spec or empty> <interactive> [keep]
# NOW=1: the old way even under QUEUE=batch. NOGATE=1: no gate (the queue, or NOW).
NOW=
NOGATE=
land() {
  local branch="$1" plan="$2" fix="$3" inter="$4" keep="${5-}" path id log alog fixes=0 tries=0 old new tree sha msg
  path=$(wt_path "$branch")
  [ -d "$path" ] || fail "no worktree at $path" || return 1
  [ -z "$(git -C "$path" status --porcelain --untracked-files=no)" ] ||
    fail "$path has uncommitted changes" || return 1
  id=${plan:+$(plan_id "$plan")}
  log="$STATE/logs/${id:-$branch}.gate.log" alog="$STATE/logs/${id:-$branch}.log"
  export_ctx "$path" "$branch"

  synced
  merge_spending_fixes || return 1

  # The plan moves to the done folder in the branch itself, so it lands with the work. A
  # private plan (ignored by git) moves on disk once the branch has landed.
  local wplan=''
  if [ -n "$plan" ]; then
    if [ "$PRIVATE" = 1 ]; then wplan="$path/$PLANS/${plan##*/}"; else wplan="$path/$PLANS/$DONE/${plan##*/}"; fi
  fi
  if [ -n "$plan" ] && [ "$PRIVATE" = 0 ] && [ -f "$path/$PLANS/${plan##*/}" ]; then
    mkdir -p "$path/$PLANS/$DONE"
    git -C "$path" mv "$PLANS/${plan##*/}" "$PLANS/$DONE/${plan##*/}" &&
      git -C "$path" commit -q -m "dangle: plan $id done" || fail "could not move the plan to $DONE/" || return 1
  fi

  if [ "$QUEUE" = batch ] && [ -z "$NOW" ] && ! has_hook land; then
    queue_land
    return
  fi

  if [ -n "$NOGATE" ]; then
    say "  gate   skipped (--no-gate)"
  else
    say "  gate   running (log $log)"
  fi
  while [ -z "$NOGATE" ] && ! run_gate "$path" "$log" "$wplan"; do
    if [ -z "$fix" ] || [ $fixes -ge "$FIXES" ]; then
      fail "the gate failed (log $log)"; return 1
    fi
    fixes=$((fixes + 1))
    say "  gate   failed; fix-up $fixes of $FIXES"
    DANGLE_T_gate_log=$log DANGLE_T_gate_tail=$(tail -n 80 "$log")
    export DANGLE_T_gate_log DANGLE_T_gate_tail
    fix_up "$fix" "$path" "$alog" || return 1
    synced
    merge_spending_fixes || return 1
  done

  take_lock "$STATE/land.lock" "another landing"
  while :; do
    tries=$((tries + 1))
    [ $tries -le 3 ] || { drop_lock "$STATE/land.lock"; fail "$BASE kept moving; try again"; return 1; }
    sync_base
    new=$(git rev-parse "refs/heads/$BASE")
    if ! git merge-base --is-ancestor "$new" "$(git -C "$path" rev-parse HEAD)"; then
      old=$(git merge-base "$new" "$(git -C "$path" rev-parse HEAD)")
      if ! merge_base_in "$path" "$inter"; then
        # No agent runs under the lock, which would hold up every other landing: let go, have
        # it resolve the merge and gate the result, then take the lock again.
        drop_lock "$STATE/land.lock"
        [ "$inter" != 1 ] || { fail "conflicts with $BASE"; return 1; }
        merge_spending_fixes || return 1
        say "  gate   running after the merge"
        [ -n "$NOGATE" ] || run_gate "$path" "$log" "$wplan" || { fail "the gate failed after the merge with $BASE (log $log)"; return 1; }
        take_lock "$STATE/land.lock" "another landing"
        continue
      fi
      if [ -z "$NOGATE" ] && { [ -n "$MERGED_BY" ] || regate_needed "$old" "$new"; }; then
        say "  gate   $BASE moved; gating again"
        run_gate "$path" "$log" "$wplan" ||
          { drop_lock "$STATE/land.lock"; fail "the gate failed after $BASE moved (log $log)"; return 1; }
      fi
    fi
    tree=$(git -C "$path" rev-parse 'HEAD^{tree}')
    if [ "$tree" = "$(git rev-parse "$new^{tree}")" ]; then
      drop_lock "$STATE/land.lock"; fail "nothing to land: the branch has no changes"; return 1
    fi
    if [ -n "$plan" ]; then
      msg="$(plan_title "$wplan")"
    elif [ "$(git -C "$path" rev-list --no-merges --count "$new..HEAD")" = 1 ]; then
      msg=$(git -C "$path" log --no-merges -1 --format=%s "$new..HEAD")
    else
      msg=$branch
    fi
    [ -n "$msg" ] || msg=$branch
    {
      printf '%s\n\nLanded by dangle from %s.\n\n' "$msg" "$branch"
      git -C "$path" log --no-merges --format='- %s' "$new..HEAD" | grep -v '^- dangle: '
    } > "$STATE/message"
    if has_hook land; then
      # The project lands it its own way (a pull request and CI, a merge commit, a queue).
      say "  land   .dangle/hooks/land"
      DANGLE_TITLE=$msg DANGLE_MESSAGE_FILE="$STATE/message" DANGLE_REMOTE=$REMOTE
      export DANGLE_TITLE DANGLE_MESSAGE_FILE DANGLE_REMOTE
      if ! hook land "$path" >> "$log" 2>&1; then
        drop_lock "$STATE/land.lock"; fail "the land hook failed (log $log)"; return 1
      fi
      drop_lock "$STATE/land.lock"
      synced
      [ -n "$plan" ] && [ "$PRIVATE" = 1 ] && done_on_disk "$plan"
      if [ -n "$plan" ] && ! is_landed "$id"; then
        # Handed off (a pull request still waiting for CI): skipped by later runs until it lands.
        mkdir -p "$STATE/submitted"; date '+%F %T' > "$STATE/submitted/$id"
        say "  land   submitted; not on $BASE yet"
        LAND_RESULT=submitted
      fi
      [ -n "$keep" ] || [ "${LAND_RESULT-}" = submitted ] || remove_worktree "$branch" force ||
        err "landed, but the worktree $path was not removed"
      return 0
    fi
    sha=$(git commit-tree "$tree" -p "$new" < "$STATE/message") ||
      { drop_lock "$STATE/land.lock"; fail "could not squash"; return 1; }
    # Someone committed on the base branch while the gate ran: take that in before pushing.
    if [ "$(git rev-parse "refs/heads/$BASE")" != "$new" ]; then
      say "  land   $BASE got a commit during the landing; syncing again"
      continue
    fi
    if [ -n "$REMOTE" ] && ! git push -q "$REMOTE" "$sha:refs/heads/$BASE" 2>/dev/null; then
      say "  land   $REMOTE/$BASE moved during the landing; syncing again"
      continue
    fi
    advance_base "$sha" "$new"
    [ -n "$plan" ] && [ "$PRIVATE" = 1 ] && done_on_disk "$plan"
    break
  done
  drop_lock "$STATE/land.lock"
  say "  land   $(git rev-parse --short "$sha") on $BASE${REMOTE:+ (pushed to $REMOTE)}"
  if [ -z "$keep" ]; then
    remove_worktree "$branch" force || err "landed, but the worktree $path was not removed"
  fi
  return 0
}

# ---------------------------------------------------------------- commands

usage() {
  cat <<'EOF'
dangle: a carrot on a stick for your coding agent.

  dangle [ids...] [options]     run the active plans in order (or only these ids)
  dangle status                 every active plan: ready, waiting, running, failed
  dangle lint                   check the active plans (size, ids, dependencies)
  dangle add <name> [title]     make the next plan file (the next free number, taken under a
                                lock so two sessions never share one) and print its path
  dangle audit [ids] [--apply]  ask the agent which plans are already implemented (read-only);
                                --apply moves those to the done folder in one commit
  dangle doctor [--agent]       check the setup (--agent also asks the agent to reply)
  dangle init                   create .dangle/ for this repository
  dangle skill [--print]        install the plan-writing skill for your agents

  dangle new <branch> [--base B]   a worktree with .dangle/copy and the setup hook
  dangle land [branch|id] [--fix] [--fix-agent SPEC] [--keep] [--now] [--no-gate]
                                gate, squash and land a worktree; with QUEUE=batch it joins the
                                merge queue (--now: gate it alone, outside the queue)
  dangle queue                  the branches waiting in the merge queue, and who drives it
  dangle rm <branch> [-f]       the teardown hook, then remove a worktree and its branch
  dangle prune [-n] [--days N] [--max-gb N] [--all] [--rm]
                                run .dangle/hooks/prune in the worktrees idle for N days or
                                over N GB; --rm also removes plan worktrees with no commits
  dangle list                   worktrees with ahead/behind, size and changes
  dangle path <branch|id>       print a worktree's path:  cd "$(dangle path 865)"

Run options:
  -a, --agent SPEC      agent for this run: claude:haiku, codex, opencode, pi:<model>,
                        an ALIAS_ from .dangle/config, or a bare model for the default
      --fix-agent SPEC  agent for fix-ups after a failed gate or merge conflict (default: the agent)
      --rest            after the ids given, run every other active plan too
      --fresh           start a plan's worktree over instead of continuing a kept one
      --follow          show the agent's output as it runs
      --watch           when the queue is empty, wait for new plans instead of ending
  -n, --dry-run         print what would run and stop
  -y, --yes             do not ask before starting
  -q, --quiet           no art

Environment: DANGLE_AGENT, DANGLE_FIX_AGENT, DANGLE_REMOTE (none = do not fetch or push),
DANGLE_QUEUE (batch = the merge queue), DANGLE_PIPELINE (landings in the background),
DANGLE_REMOTE_CLAIMS (1 = claims shared through the remote).
Configuration: ~/.config/dangle/config (yours: AGENT=, ALIAS_), then the repository's
.dangle/config, .dangle/copy, .dangle/hooks/*, .dangle/prompt.md (see README).
EOF
}

# note_result <result>: one plan's line in its result file, the summary and the progress bar.
note_result() {
  printf '%s %s\n' "$(date '+%F %T')" "$1" > "$STATE/results/$id"
  printf -- '- %s %s (%s): %s\n' "$id" "$1" "$(minutes "$t0" "$(date +%s)")" "$(plan_title "$f" 2>/dev/null)" >> "$summary"
  say "  $(progress_bar "$n" "$total")  $n/$total  $id $1  $(minutes "$t0" "$(date +%s)")"
}

# pick_up: queues the active plans that appeared since the run started (cmd_run's pending,
# known and total). A plan not yet committed on the base branch, or a private one changed in
# the last minute, is left for the next look.
pick_up() {
  local g
  for g in $(plan_files); do
    case "
$known
" in *"
$g
"*) continue ;; esac
    if [ "$PRIVATE" = 0 ]; then
      git cat-file -e "refs/heads/$BASE:$PLANS/${g##*/}" 2>/dev/null || continue
    else
      [ -n "$(find "$g" -mmin +1 2>/dev/null)" ] || continue
    fi
    known="$known
$g"
    pending=$(printf '%s\n%s\n' "$pending" "$g" | sed '/^$/d')
    total=$((total + 1))
    say ""; say "  picked up  $(plan_id "$g")  $(plan_title "$g")"
    printf -- '- %s picked up during the run: %s\n' "$(plan_id "$g")" "$(plan_title "$g")" >> "$summary"
  done
}

# prune: drops from the queue (cmd_run's pending and total) the plans another dangle finished
# meanwhile: landed (the file left the plans folder) or failed since this run started. They
# are not this run's steps, so they leave the count instead of showing as skipped.
prune() {
  local g gid why keep=''
  for g in $pending; do
    gid=$(plan_id "$g")
    if [ ! -f "$g" ]; then
      if is_landed "$gid"; then why="landed by another run"; else why="no longer in $PLANS"; fi
    elif ! running_elsewhere "$gid" && [ -n "$(find "$STATE/results/$gid" -newer "$STATE/started.$$" 2>/dev/null)" ] &&
      grep -q ' FAILED' "$STATE/results/$gid"; then
      why="failed in another run (dangle status)"
    else
      keep="$keep
$g"; continue
    fi
    total=$((total - 1)); elsewhere=$((elsewhere + 1))
    say "  $gid  $why"
    printf -- '- %s %s\n' "$gid" "$why" >> "$summary"
  done
  pending=$(printf '%s\n' "$keep" | sed '/^$/d')
}

# idle: one poll of --watch; 1 when Ctrl-C (or TERM) asks the run to end.
idle() {
  trap 'STOP=1' INT TERM
  local s
  sleep "${DANGLE_POLL:-30}" & s=$!
  wait $s 2>/dev/null
  kill $s 2>/dev/null
  trap 'cleanup; exit 130' INT TERM
  [ $STOP = 0 ] || { say ""; say "  stopped watching"; return 1; }
  synced
}

# ---------------------------------------------------------------- landing in the background
# PIPELINE=N: once a plan's agent has finished, land() (gate, fix-ups, the merge queue) runs in a
# background subshell and the run starts the next plan. Its output goes to
# $STATE/logs/<id>.land.log; its result to $STATE/bg/<pid>.<id>/result, which reap takes up.
# The subshell shares the run's pid, so the plan's claim and the queue entry stay the run's.

bg_count() {
  local d k=0
  for d in "$STATE"/bg/$$.*; do [ -d "$d" ] && k=$((k + 1)); done
  printf '%s' $k
}

# bg_land <id> <branch> <plan file> <fix agent> <worktree> <t0> <agent secs>
bg_land() {
  local d="$STATE/bg/$$.$1" log="$STATE/logs/$1.land.log"
  mkdir -p "$d"
  printf '%s\n' "$3" > "$d/plan"; printf '%s\n' "$5" > "$d/path"
  plan_title "$3" > "$d/title"
  printf '%s %s %s\n' "$6" "$7" "$n" > "$d/times"
  say "  land   in the background (log $log); on to the next plan"
  (
    trap - EXIT INT TERM
    BG=".$1" LAND_RESULT='' FAIL_REASON='' r=failed
    if wait_parent "$2" && land "$2" "$3" "$4" 0; then r=${LAND_RESULT:-landed}; fi
    rm -f "$STATE/ready/$1"
    printf '%s\n%s\n' "$r" "$FAIL_REASON" > "$d/result.tmp" && mv "$d/result.tmp" "$d/result"
  ) > "$log" 2>&1 < /dev/null &
  echo $! > "$d/pid"
}

# reap [wait]: takes up the background landings that have finished, as cmd_run takes up a plan
# it landed itself (its locals: landed, failed, fast, summary, total). With `wait`, waits until
# at least one has finished.
reap() {
  local d id f t0 t1 n result path pid got=0 FAIL_REASON title
  while :; do
    for d in "$STATE"/bg/$$.*; do
      [ -d "$d" ] || continue
      id=${d##*/$$.}
      if [ ! -f "$d/result" ]; then
        pid=$(cat "$d/pid" 2>/dev/null || true)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
        printf 'failed\nthe landing stopped (log %s)\n' "$STATE/logs/$id.land.log" > "$d/result"
      fi
      result=$(sed -n 1p "$d/result"); FAIL_REASON=$(sed -n 2p "$d/result")
      f=$(cat "$d/plan"); path=$(cat "$d/path"); title=$(cat "$d/title")
      read -r t0 t1 n < "$d/times"
      rm -rf "$d"
      got=1
      say ""
      say "  $id  $title"
      grep -E '^  (land|queue|gate) ' "$STATE/logs/$id.land.log" 2>/dev/null | tail -n 1
      if [ "$result" = landed ] || [ "$result" = submitted ]; then
        landed=$((landed + 1)); fast=0
      else
        failed=$((failed + 1))
        result="FAILED   $FAIL_REASON; kept $path"
        if [ "${t1:-999}" -lt 60 ]; then fast=$((fast + 1)); fastwhy=$FAIL_REASON; else fast=0; fi
      fi
      unclaim "$id"
      note_result "$result"
      record_duration "$(( $(date +%s) - t0 ))"
    done
    [ "${1-}" = wait ] && [ $got = 0 ] && [ "$(bg_count)" -gt 0 ] || break
    sleep "${DANGLE_QUEUE_POLL:-3}"
  done
}

cmd_run() {
  local ids='' rest=0 dry=0 yes=0 agent='' fixagent='' f id queue='' total=0 n=0 landed=0 failed=0 skipped=0 \
    t0 t1 tstart spec path branch result fast=0 fastwhy='' deps summary line watch=0 rescan=0 known STOP=0 elsewhere=0 \
    notrun=0 NOT_RUN waits w
  FRESH=0 FOLLOW=0
  while [ $# -gt 0 ]; do
    case $1 in
      -a|--agent) agent=${2-}; shift ;;
      --agent=*) agent=${1#*=} ;;
      --fix-agent) fixagent=${2-}; shift ;;
      --fix-agent=*) fixagent=${1#*=} ;;
      --rest) rest=1 ;;
      --fresh) FRESH=1 ;;
      --follow) FOLLOW=1 ;;
      --watch) watch=1 ;;
      -n|--dry-run) dry=1 ;;
      -y|--yes) yes=1 ;;
      -q|--quiet) QUIET=1 ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown option $1 (dangle --help)" ;;
      *) ids="$ids $(printf '%s' "$1" | tr ',' ' ')" ;;
    esac
    shift
  done
  agent=${agent:-${DANGLE_AGENT:-}}
  fixagent=${fixagent:-${DANGLE_FIX_AGENT:-$(cfg FIX_AGENT)}}
  [ -n "$(cfg AGENT)$agent" ] || die "no agent: set AGENT= in .dangle/config (dangle init) or pass -a"
  [ -d "$PRIMARY/$PLANS" ] || die "no plans folder $PLANS (set PLANS= in .dangle/config)"
  if [ "$PRIVATE" = 0 ] && [ -n "$(git -C "$PRIMARY" status --porcelain --untracked-files=all -- "$PLANS")" ] && [ $dry = 0 ]; then
    err "the plans folder has changes that are not committed; a worktree only sees committed plans:"
    git -C "$PRIMARY" status --short -- "$PLANS" >&2
    exit 1
  fi
  [ $dry = 1 ] || require_clean_base
  # A run of every active plan (no ids, or --rest) looks for new plans before each one.
  if [ -z "$ids" ] || [ $rest = 1 ]; then rescan=1; fi
  [ $watch = 0 ] || [ $rescan = 1 ] || die "--watch waits for new active plans; with ids, add --rest"

  # The queue: the ids given, in that order (then the rest with --rest), or every active plan.
  for id in $ids; do
    f=$(find_plan "$id") || die "no active plan '$id' in $PLANS"
    queue="$queue
$f"
  done
  if [ -z "$ids" ] || [ $rest = 1 ]; then
    for f in $(plan_files); do
      case "$queue
" in *"
$f
"*) continue ;; esac
      queue="$queue
$f"
    done
  fi
  queue=$(printf '%s\n' "$queue" | sed '/^$/d')
  [ -n "$queue" ] || [ $watch = 1 ] || { say "dangle: no active plans in $PLANS"; return 0; }
  total=$(printf '%s\n' "$queue" | sed '/^$/d' | wc -l | tr -d ' ')
  known=$queue

  if [ $dry = 1 ]; then
    # The order a run would take if every plan landed: the first ready plan, again and again.
    say "dangle would run $total plan(s) from $PLANS onto $BASE, in this order:"
    local assumed='' pending=$queue
    while f=$(first_ready "$pending" "$assumed"); do
      printf '  %-8s %s\n' "$(plan_id "$f")" "$(plan_title "$f")"
      assumed="$assumed $(plan_id "$f")"
      pending=$(without "$pending" "$f")
    done
    for f in $pending; do
      deps=$(unmet "$f" "$assumed" | tr '\n' ' ')
      printf '  %-8s %s   (never: waits for %s, which is not active)\n' "$(plan_id "$f")" "$(plan_title "$f")" "${deps% }"
    done
    return 0
  fi

  resolve_agent "${agent:-$(cfg AGENT)}" "$(cfg AGENT)"
  local estimate said_estimate=0
  estimate=$(estimate_run "$total")
  if [ $yes = 0 ] && [ -t 0 ] && [ -t 1 ]; then
    say "  $estimate"
    said_estimate=1
    printf 'Run %s plan(s)%s with %s onto %s? [Y/n] ' "$total" "$([ $watch = 1 ] && printf ' and watch for more')" "$AGENT_LABEL" "$BASE"
    read -r line || line=n
    case $line in ''|y|Y|yes) ;; *) return 0 ;; esac
  fi

  # Keep the computer awake for the night (Linux re-runs dangle under systemd-inhibit in main).
  if [ -z "${DANGLE_AWAKE:-}" ] && command -v caffeinate >/dev/null 2>&1; then
    caffeinate -i -w $$ &
  fi

  trap 'cleanup; exit 130' INT TERM
  trap cleanup EXIT
  summary="$STATE/last-run.md"
  : > "$STATE/started.$$"
  printf '# dangle run %s\n\nagent %s, base %s\n\n' "$(date)" "$AGENT_LABEL" "$BASE" > "$summary"
  art_stick
  say "  dangle · $total plan(s)$([ $watch = 1 ] && printf ', watching for more') · agent $AGENT_LABEL · base $BASE"
  [ $said_estimate = 1 ] || say "  $estimate"
  find "$STATE" -maxdepth 1 -name 'landed-*' -mtime +1 -exec rm -f {} + 2>/dev/null
  synced
  # Space: worktrees left behind by earlier runs (kept plans, the merge queue) get pruned
  # before another night of builds starts, and again at the end.
  prune_auto
  tstart=$(date +%s)

  # Again and again: the first plan, in order, whose dependencies have landed. A plan that
  # waits for one that failed is left for the end. A plan that waits for one another dangle
  # is running (a second terminal) waits for it to land.
  # A plan written (and, unless the plans are private, committed) while dangle runs joins the
  # queue at its end. With --watch an empty or blocked queue waits for more instead of ending.
  local pending=$queue waiting said='' parent from
  mkdir -p "$STATE/bg"
  while :; do
    # Landings in the background that finished (PIPELINE).
    reap
    if [ $fast -ge 2 ]; then
      say ""
      say "  stopping: the agent failed fast twice in a row; the last: $fastwhy"
      printf '\nStopped early: the agent failed fast twice in a row; the last: %s\n' "$fastwhy" >> "$summary"
      break
    fi
    claims_seen
    [ $rescan = 0 ] || pick_up
    prune
    if [ -z "$pending" ]; then
      [ $watch = 1 ] || break
      [ "$said" = idle ] || { say ""; say "  watching $PLANS for new plans (Ctrl-C ends the run)"; }
      said=idle
      idle || break
      continue
    fi
    # A plan another dangle runs stays queued: it lands there (prune drops it), or comes back
    # here when that dangle dies.
    if ! f=$(first_runnable "$(mine "$pending")"); then
      # What waits may wait for a plan landing here in the background: let one finish first.
      if [ "$(bg_count)" -gt 0 ]; then
        [ "$said" = landing ] || say "  waiting for a landing in the background"
        said=landing
        reap wait
        synced
        continue
      fi
      waiting=''
      for f in $pending; do
        if running_elsewhere "$(plan_id "$f")"; then waiting="$waiting $(plan_id "$f")"; continue; fi
        for d in $(unmet "$f"); do running_elsewhere "$d" && waiting="$waiting $d"; done
      done
      [ -z "$waiting" ] || { waiting=$(printf '%s\n' $waiting | sort -u | tr '\n' ' '); waiting=" ${waiting% }"; }
      if [ -n "$waiting" ]; then
        [ "$said" = "$waiting" ] || say "  waiting for$waiting: another dangle is running it$(
          for d in $waiting; do h=$(claim_host "$d") && printf ' (%s on %s)' "$d" "$h"; done)"
        said=$waiting
        sleep "${DANGLE_POLL:-30}"
        synced
        continue
      fi
      if [ $watch = 1 ]; then
        # Blocked by a plan that failed or is not active: it may still land (dangle 866 in
        # another terminal), so keep watching.
        waiting=$(for f in $pending; do unmet "$f"; done | sort -u | tr '\n' ' ')
        [ "$said" = "blocked $waiting" ] || { say ""; say "  watching: $(printf '%s\n' "$pending" | wc -l | tr -d ' ') plan(s) wait for ${waiting% }, which has not landed"; }
        said="blocked $waiting"
        idle || break
        continue
      fi
      for f in $pending; do
        n=$((n + 1)); id=$(plan_id "$f"); t0=$(date +%s); skipped=$((skipped + 1))
        deps=$(unmet "$f" | tr '\n' ' ')
        say ""
        say "  $id  $(plan_title "$f")"
        note_result "skipped  (waits for ${deps% })"
      done
      break
    fi
    id=$(plan_id "$f")
    # Lost a race for the claim: the next look sees the plan as running elsewhere.
    [ -f "$STATE/submitted/$id" ] && [ -z "$ids" ] || claim "$id" || continue
    # Another computer took it first (REMOTE_CLAIMS): the next look sees it running there.
    if ! remote_claim "$id"; then
      drop_lock "$STATE/claims/$id"
      continue
    fi
    pending=$(without "$pending" "$f"); said=''
    n=$((n + 1)); branch="$PREFIX$id"; path=$(wt_path "$branch")
    say ""
    say "  $id  $(plan_title "$f")"
    t0=$(date +%s); result='' t1='' timed=0 NOT_RUN=
    if [ "$PRIVATE" = 0 ] && ! git cat-file -e "refs/heads/$BASE:$PLANS/${f##*/}" 2>/dev/null; then
      result="skipped  (not committed on $BASE)"
    elif [ -f "$STATE/submitted/$id" ] && [ -z "$ids" ]; then
      result="skipped  (submitted $(cat "$STATE/submitted/$id"); waiting for it to land)"
    fi
    if [ -n "$result" ]; then
      skipped=$((skipped + 1)); unclaim "$id"
    else
      FAIL_REASON='' NOT_RUN=''
      if [ -d "$path" ] && [ $FRESH = 0 ]; then
        say "  worktree  continuing $path"
      else
        [ -d "$path" ] && remove_worktree "$branch" force
        git show-ref -q --verify "refs/heads/$branch" && [ $FRESH = 1 ] && git branch -q -D "$branch"
        parent=$(stack_parent "$f")
        from=$(sed -n 1p "$STATE/ready/$parent" 2>/dev/null)
        if [ -n "$parent" ] && [ -n "$from" ] && git show-ref -q --verify "refs/heads/$from"; then
          # PIPELINE: it waits only for a plan landing here; start on that plan's branch, and
          # land after it.
          say "  worktree  on $from: $parent is landing"
          if new_worktree "$branch" "refs/heads/$from"; then
            git config "branch.$branch.dangleparent" "$parent"
          else
            FAIL_REASON="could not create the worktree"
          fi
        else
          new_worktree "$branch" || FAIL_REASON="could not create the worktree"
        fi
      fi
      spec=${agent:-$(plan_field "$f" agent)}
      spec=${spec:-$(cfg AGENT)}
      if [ -z "$FAIL_REASON" ] && on_base "$branch"; then
        # Its work landed by hand: no agent, only the plan to retire.
        say "  worktree  its work is on $BASE already (landed by hand); retiring the plan"
        git -C "$path" reset -q --hard "refs/heads/$BASE"
        if [ "$PRIVATE" = 1 ]; then
          done_on_disk "$f" && remove_worktree "$branch" force && result=landed
        else
          LAND_RESULT=
          if land "$branch" "$f" '' 0; then result=${LAND_RESULT:-landed}; fi
        fi
      elif [ -z "$FAIL_REASON" ]; then
        export_ctx "$path" "$branch"
        DANGLE_PLAN=$id DANGLE_PLAN_FILE="$PLANS/${f##*/}"; export DANGLE_PLAN DANGLE_PLAN_FILE
        DANGLE_T_plan="$PLANS/${f##*/}" DANGLE_T_id=$id DANGLE_T_branch=$branch DANGLE_T_base=$BASE \
          DANGLE_T_title=$(plan_title "$f") DANGLE_T_gate=$(gate_desc)
        export DANGLE_T_plan DANGLE_T_id DANGLE_T_branch DANGLE_T_base DANGLE_T_title DANGLE_T_gate
        timed=1
        # Started on another plan's branch: only the commits since that start are the agent's.
        from="refs/heads/$BASE"
        [ -z "$(git config "branch.$branch.dangleparent" 2>/dev/null)" ] ||
          from=$(git config "branch.$branch.danglebase" 2>/dev/null || printf '%s' "$from")
        # An agent that never got to work (the provider overloaded or out of credit) is tried
        # again after each RETRY_WAIT; then the plan is NOT RUN, not FAILED.
        waits=$(cfg RETRY_WAIT "5m 15m")
        while :; do
          NOT_RUN='' t1=$(date +%s)
          run_agent "$spec" "$path" "$STATE/logs/$id.log" "$(render "$(template prompt.md "$DEFAULT_PROMPT")")"
          t1=$(( $(date +%s) - t1 ))
          commit_leftovers "$path"
          [ "$(git rev-list --count "$from..$branch")" = 0 ] || break
          NOT_RUN=$(not_run_reason "$STATE/logs/$id.log") || { NOT_RUN=; break; }
          # An agent that exits with an error at once (a bad flag, a missing command) is not run; one
          # that ran a while and then failed (an agent with no tool lines in the log) is the plan's.
          case $NOT_RUN in
            provider\ *) ;;
            *) [ "$t1" -lt 60 ] || NOT_RUN=; break ;;
          esac
          w=${waits%% *}
          case $w in ''|0|0[smh]) break ;; esac
          waits=${waits#"$w"}; waits=${waits# }
          say "  agent  not run (${NOT_RUN#provider }); trying again in $w"
          printf 'dangle: not run (%s); trying again in %s\n' "${NOT_RUN#provider }" "$w" >> "$STATE/logs/$id.log"
          sleep "$(to_secs "$w")"
        done
        if [ -n "$NOT_RUN" ]; then
          :
        elif [ "$(git rev-list --count "$from..$branch")" = 0 ]; then
          FAIL_REASON="the agent made no commits (log $STATE/logs/$id.log)"
          w=$(agent_said "$STATE/logs/$id.log" | cut -c1-200)
          [ -z "$w" ] || FAIL_REASON="$FAIL_REASON; it said: $w"
        else
          # Its branch can be built on while it lands (PIPELINE runs here and in other runners).
          mark_ready "$id" "$branch"
          if [ "$PIPELINE" -gt 0 ]; then
            while [ "$(bg_count)" -ge "$PIPELINE" ]; do reap wait; done
            bg_land "$id" "$branch" "$f" "${fixagent:-$spec}" "$path" "$t0" "$t1"
            continue
          fi
          LAND_RESULT=
          if wait_parent "$branch" && land "$branch" "$f" "${fixagent:-$spec}" 0; then
            result=${LAND_RESULT:-landed}
          fi
          rm -f "$STATE/ready/$id"
        fi
      fi
      if [ "$result" = landed ] || [ "$result" = submitted ]; then
        landed=$((landed + 1)); fast=0
      elif [ -n "$NOT_RUN" ]; then
        # Not the plan's failure: the plan stays queued for the next run, its empty worktree goes.
        notrun=$((notrun + 1))
        remove_worktree "$branch" force || true
        result="NOT RUN  ${NOT_RUN#provider } (log $STATE/logs/$id.log); the plan stays queued"
      else
        failed=$((failed + 1))
        result="FAILED   $FAIL_REASON; kept $path"
        if [ "${t1:-999}" -lt 60 ]; then fast=$((fast + 1)); fastwhy=$FAIL_REASON; else fast=0; fi
      fi
      unclaim "$id"
    fi
    note_result "$result"
    [ "$timed" = 1 ] && record_duration "$(( $(date +%s) - t0 ))"
    if [ -n "${NOT_RUN:-}" ]; then
      # The next plan would meet the same provider or the same broken agent.
      say ""
      say "  stopping: the agent could not run (${NOT_RUN#provider })"
      printf '\nStopped early: the agent could not run (%s).\n' "${NOT_RUN#provider }" >> "$summary"
      break
    fi
    if [ $fast -ge 2 ]; then
      say ""
      say "  stopping: the agent failed fast twice in a row; the last: $fastwhy"
      printf '\nStopped early: the agent failed fast twice in a row; the last: %s\n' "$fastwhy" >> "$summary"
      break
    fi
  done
  # The landings still under way in the background.
  while [ "$(bg_count)" -gt 0 ]; do reap wait; done

  prune_auto
  printf '\n%s landed, %s failed, %s not run, %s skipped, %s finished by another run, %s\n' "$landed" "$failed" "$notrun" "$skipped" "$elsewhere" "$(minutes "$tstart" "$(date +%s)")" >> "$summary"
  if [ $landed -gt 0 ]; then art_carrot; else fancy && art_stick && say "  no carrot tonight"; fi
  say ""
  say "  $landed landed · $failed failed$([ $notrun = 0 ] || printf ' · %s not run' "$notrun") · $skipped skipped$([ $elsewhere = 0 ] || printf ' · %s by another run' "$elsewhere") · $(minutes "$tstart" "$(date +%s)")"
  say "  summary: $summary"
  [ -x "$HOOKS/done" ] && hook "done" "$PRIMARY" "$summary"
  [ $failed = 0 ] && [ $notrun = 0 ]
}

cmd_status() {
  local f id state pid r deps host
  claims_seen
  printf '%-8s %-10s %s\n' ID STATE PLAN
  for f in $(plan_files); do
    id=$(plan_id "$f")
    pid=$(cat "$STATE/claims/$id/pid" 2>/dev/null || true)
    deps=$(unmet "$f" | tr '\n' ' ')
    host=''
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      state="running"
      ready_live "$id" && state="landing"
    elif host=$(claim_host "$id"); then state="running"
    elif [ -f "$STATE/submitted/$id" ]; then state="submitted"
    elif [ -n "$deps" ]; then state="waiting"
    elif on_base "$PREFIX$id"; then state="on-$BASE"
    elif [ -d "$(wt_path "$PREFIX$id")" ]; then state="kept"
    else state="ready"; fi
    printf '%-8s %-10s %s\n' "$id" "$state" "$(plan_title "$f")"
    [ -n "$host" ] && printf '%-19s on %s\n' '' "$host"
    [ -n "$deps" ] && printf '%-19s waits for %s\n' '' "${deps% }"
    r=$(cat "$STATE/results/$id" 2>/dev/null || true)
    case $r in *FAILED*) printf '%-19s last: %s\n' '' "$r" ;; esac
  done
  [ -f "$STATE/last-run.md" ] && say "" && say "last run: $STATE/last-run.md"
}

cmd_lint() {
  local f id lines ids='' errors=0 warnings=0 d all
  all=$( { for f in $(plan_files); do plan_id "$f"; done; landed_ids; } | sort -u)
  local landed parked
  landed=" $(landed_ids | tr '\n' ' ') "
  parked=" $(find "$PRIMARY/$PLANS" -mindepth 2 -name '*.md' ! -path "*/$DONE/*" 2>/dev/null |
    while read -r d; do plan_id "$d"; done | tr '\n' ' ') "
  for f in $(plan_files); do
    id=$(plan_id "$f")
    case " $ids " in *" $id "*) err "${f##*/}: id $id is used by another plan"; errors=$((errors + 1)) ;; esac
    case $landed in *" $id "*) err "${f##*/}: id $id is a landed plan's; take a new one (dangle add)"; errors=$((errors + 1)) ;; esac
    case $parked in *" $id "*) say "warning: ${f##*/}: id $id is also a parked plan's"; warnings=$((warnings + 1)) ;; esac
    ids="$ids $id"
    lines=$(wc -l < "$f" | tr -d ' ')
    [ "$lines" -le "$MAX_LINES" ] || { say "warning: ${f##*/}: $lines lines (MAX_LINES=$MAX_LINES); split it?"; warnings=$((warnings + 1)); }
    [ -n "$(plan_title "$f")" ] || { say "warning: ${f##*/}: no '# title' line"; warnings=$((warnings + 1)); }
    for d in $(plan_field "$f" depends | tr ',' ' '); do
      printf '%s\n' "$all" | awk -v d="$d" '$0 == d || index($0, d "-") == 1 { f = 1 } END { exit !f }' || { err "${f##*/}: depends on $d, which is neither active nor landed"; errors=$((errors + 1)); }
    done
  done
  # The project's own checks: .dangle/hooks/lint <plan files>; a non-zero exit is an error.
  if has_hook lint && [ -n "$(plan_files)" ]; then
    # shellcheck disable=SC2046
    ( cd "$PRIMARY" && "$HOOKS/lint" $(plan_files) ) || errors=$((errors + 1))
  fi
  say "lint: $(plan_files | wc -l | tr -d ' ') active plan(s), $errors error(s), $warnings warning(s)"
  [ $errors = 0 ]
}

cmd_doctor() {
  local probe=0 bad=0 w out fixspec
  [ "${1-}" = --agent ] && probe=1
  ok() { printf '  ok    %s\n' "$*"; }
  no() { printf '  FAIL  %s\n' "$*"; bad=1; }
  warn() { printf '  note  %s\n' "$*"; }
  say "dangle $VERSION in $PRIMARY"
  git show-ref -q --verify "refs/heads/$BASE" && ok "base branch $BASE" || no "base branch '$BASE' does not exist (BASE= in .dangle/config)"
  [ -d "$PRIMARY/$PLANS" ] && ok "plans in $PLANS ($(plan_files | wc -l | tr -d ' ') active)" || no "no plans folder $PLANS (PLANS=)"
  [ "$PRIVATE" = 0 ] || ok "$PLANS is ignored by git: private plans (copied into worktrees, moved to $DONE/ on disk)"
  [ -f "$DOT/config" ] && ok ".dangle/config" || warn "no .dangle/config: run dangle init"
  if has_hook gate; then ok "gate hook"; else no "no executable .dangle/hooks/gate: nothing would check the work"; fi
  for w in setup teardown regate land lint "done"; do
    if [ -e "$HOOKS/$w" ] && [ ! -x "$HOOKS/$w" ]; then no ".dangle/hooks/$w is not executable (chmod +x)"; fi
  done
  if [ -n "$(cfg AGENT)" ]; then
    resolve_agent "$(cfg AGENT)" ""
    command -v "${AGENT_CMD%% *}" >/dev/null 2>&1 && ok "agent $AGENT_LABEL (${AGENT_CMD%% *})" || no "agent command '${AGENT_CMD%% *}' not found"
  else
    no "no AGENT= in .dangle/config"
  fi
  fixspec=${DANGLE_FIX_AGENT:-$(cfg FIX_AGENT)}
  if [ -n "$fixspec" ]; then
    resolve_agent "$fixspec" "$(cfg AGENT)"
    command -v "${AGENT_CMD%% *}" >/dev/null 2>&1 && ok "fix agent $AGENT_LABEL" || no "fix agent command '${AGENT_CMD%% *}' not found"
  fi
  if [ -z "$REMOTE" ]; then
    warn "no remote: landings stay local"
  elif out=$(git ls-remote -q "$REMOTE" "refs/heads/$BASE" 2>&1); then
    ok "remote $REMOTE (fetched before and pushed after each landing)"
  else
    warn "cannot reach $REMOTE: landings will fail until it is reachable"
    printf '%s\n' "$out" | sed 's/^/        /'
    case $out in *publickey*|*"Permission denied"*) warn "if this is SSH, check your agent: ssh-add -l" ;; esac
  fi
  [ -n "$TIMEOUT_BIN" ] && ok "time limits ($TIMEOUT_BIN)" || warn "no timeout command (coreutils); a hung agent's own children may outlive its time limit"
  command -v systemd-inhibit >/dev/null 2>&1 || command -v caffeinate >/dev/null 2>&1 || warn "nothing to keep the computer awake (systemd-inhibit or caffeinate)"
  if [ $probe = 1 ]; then
    # The fix agent too: it runs only after a gate fails or a merge conflicts, hours into a run.
    for w in AGENT FIX_AGENT; do
      [ -n "$(cfg $w)" ] || continue
      resolve_agent "$(cfg $w)" "$(cfg AGENT)"
      say "  ...   asking $AGENT_LABEL ($w) to reply (up to 3 minutes)"
      out=$(cd "$PRIMARY" && set -f && set -- $AGENT_CMD && set +f && DANGLE=1 run_limited 180 "$@" "Reply with the single word OK and do nothing else." < /dev/null 2>&1)
      case $out in *OK*) ok "$w replied" ;; *) no "$w did not reply OK:"; printf '%s\n' "$out" | tail -n 15 | sed 's/^/        /' ;; esac
    done
  fi
  return $bad
}

# ---------------------------------------------------------------- audit

# dangle audit [ids] [-a agent] [--apply]: asks the agent, plan by plan, whether a plan is
# already implemented (for a repository whose plans folder fell behind its code). It runs in
# a throwaway checkout of the base branch and changes nothing; --apply then moves the plans
# found done to the done folder in one commit.
cmd_audit() {
  local ids='' apply=0 agent='' f id queue='' path log verdict report n=0 found='' bw
  while [ $# -gt 0 ]; do
    case $1 in
      -a|--agent) agent=${2-}; shift ;;
      --agent=*) agent=${1#*=} ;;
      --apply) apply=1 ;;
      -q|--quiet) QUIET=1 ;;
      -*) die "unknown option $1" ;;
      *) ids="$ids $1" ;;
    esac
    shift
  done
  for id in $ids; do f=$(find_plan "$id") || die "no active plan '$id'"; queue="$queue $f"; done
  [ -n "$ids" ] || queue=$(plan_files)
  [ -n "$queue" ] || { say "dangle: no active plans in $PLANS"; return 0; }
  agent=${agent:-${DANGLE_AGENT:-$(cfg AGENT)}}
  resolve_agent "$agent" "$(cfg AGENT)"
  path="$PRIMARY/$WORKTREES/.dangle-audit"
  [ -d "$path" ] && git worktree remove --force "$path"
  ensure_excluded
  git worktree add -q --detach "$path" "refs/heads/$BASE" || die "could not make a checkout of $BASE"
  [ "$PRIVATE" = 0 ] || { mkdir -p "$path/$PLANS" && cp -R "$PRIMARY/$PLANS/." "$path/$PLANS/"; }
  trap 'cleanup; git worktree remove --force "$path" 2>/dev/null; exit 130' INT TERM
  report="$STATE/audit.md"
  printf '# dangle audit %s (agent %s)\n\n' "$(date)" "$AGENT_LABEL" > "$report"
  say "dangle audit: $(printf '%s\n' $queue | wc -l | tr -d ' ') plan(s) with $AGENT_LABEL, read-only"
  for f in $queue; do
    n=$((n + 1)); id=$(plan_id "$f"); log="$STATE/logs/$id.audit.log"
    : > "$log"
    say ""
    say "  $id  $(plan_title "$f")"
    DANGLE_T_plan="$PLANS/${f##*/}"; export DANGLE_T_plan
    run_agent "$agent" "$path" "$log" "$(render "$(template audit-prompt.md "$DEFAULT_AUDIT_PROMPT")")"
    git -C "$path" reset -q --hard && git -C "$path" clean -qfd
    verdict=$(sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$log" | grep -o 'DANGLE-AUDIT: .*' | tail -n 1 | sed 's/^DANGLE-AUDIT: *//; s/[*`]*$//')
    case $verdict in
      done*) found="$found $f" ;;
      partial*|todo*) ;;
      *) verdict="unknown (no DANGLE-AUDIT line; log $log)" ;;
    esac
    say "  audit  $verdict"
    printf -- '- %s %s: %s\n' "$id" "$(plan_title "$f")" "$verdict" >> "$report"
  done
  git worktree remove --force "$path"
  say ""
  say "  report: $report"
  [ -n "$found" ] || { say "  no plan was found done"; return 0; }
  if [ $apply = 0 ]; then
    say "  $(printf '%s\n' $found | wc -l | tr -d ' ') found done. Check them, then: dangle audit --apply$ids (moves them to $PLANS/$DONE/ in one commit)"
    return 0
  fi
  if [ "$PRIVATE" = 1 ]; then
    for f in $found; do done_on_disk "$f"; done
    say "  moved to $PLANS/$DONE/ (private plans: not committed)"
    return 0
  fi
  bw=$(base_checkout)
  [ -n "$bw" ] || die "--apply needs $BASE checked out (to commit the moves)"
  require_clean_base
  mkdir -p "$bw/$PLANS/$DONE"
  for f in $found; do git -C "$bw" mv "$PLANS/${f##*/}" "$PLANS/$DONE/${f##*/}"; done
  git -C "$bw" commit -q -m "dangle audit: $(printf '%s\n' $found | wc -l | tr -d ' ') plan(s) already implemented" \
    -m "$(for f in $found; do printf -- '- %s\n' "$(plan_title "$bw/$PLANS/$DONE/${f##*/}")"; done)"
  say "  moved to $PLANS/$DONE/ and committed on $BASE: $(git -C "$bw" rev-parse --short HEAD) (not pushed)"
}

# ---------------------------------------------------------------- init

write_new() { # <path> <mode>; content on stdin
  if [ -e "$1" ]; then say "  kept     ${1#"$PRIMARY"/} (exists)"; cat > /dev/null; return; fi
  cat > "$1"; [ "${2-}" = x ] && chmod +x "$1"
  say "  created  ${1#"$PRIMARY"/}"
}

cmd_init() {
  local gate='echo "dangle: write your checks in .dangle/hooks/gate" >&2; exit 1' setup='' copy='' agent=claude
  cd "$PRIMARY" || exit 1
  if [ -f Cargo.toml ]; then gate='cargo fmt --all --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace'; copy="$copy
# A warm build directory (copy-on-write on btrfs, xfs and APFS; a full copy elsewhere).
# target"
  elif [ -f package.json ]; then
    local pm=npm
    [ -f pnpm-lock.yaml ] && pm=pnpm; [ -f yarn.lock ] && pm=yarn; [ -f bun.lockb ] || [ -f bun.lock ] && pm=bun
    gate="$pm test"
    copy="$copy
node_modules"
    setup="# Bring the copied node_modules up to date with this branch's lockfile.
$pm install"
  elif [ -f go.mod ]; then gate='go vet ./...
go test ./...'
  elif [ -f pyproject.toml ] || [ -f requirements.txt ]; then gate='pytest'; copy="$copy
.venv"
  elif [ -f Gemfile ]; then
    if [ -x bin/rails ]; then gate='bin/rails test'; else gate='bundle exec rake'; fi
  elif [ -f Makefile ] && grep -q '^test:' Makefile; then gate='make test'
  fi
  [ -f .env ] && copy=".env$copy"
  for a in claude codex opencode pi; do command -v $a >/dev/null 2>&1 && { agent=$a; break; }; done
  mkdir -p .dangle/hooks
  write_new .dangle/config <<EOF
# dangle settings: KEY=value, one per line. Read, never run.
BASE=$BASE
PLANS=$PLANS
# Landed plans move here, inside PLANS.
DONE=done
# The agent: claude (Claude Code, the default), codex, opencode or pi, with an optional
# :model (claude:sonnet, codex:gpt-5, pi:ollama/qwen3), or a command of your own that takes
# the prompt last.
# Unset, each person's own default applies (~/.config/dangle/config, else claude). Found here:
# AGENT=$agent
# FIX_AGENT=claude:sonnet  (fix-ups; default: AGENT)
# Fix-up runs after a failed gate or merge conflict (0 = none).
FIXES=1
AGENT_TIMEOUT=4h
# An agent with no new commit for this long is stopped (0 = never).
STALL_TIMEOUT=60m
GATE_TIMEOUT=60m
# Short names for -a:  dangle -a cheap
# ALIAS_cheap=claude:haiku
# REMOTE=origin   (none = never fetch or push)
# WORKTREES=.worktrees
# BRANCH_PREFIX=plan-
# MAX_LINES=300
EOF
  write_new .dangle/copy <<EOF
# Paths copied from the main checkout into every new worktree (before the setup hook).
# Copies are copy-on-write where the disk allows. 'link <path>' makes a symlink instead.
# Use this for files git does not track: .env, node_modules, a warm build directory.$copy
EOF
  write_new .dangle/hooks/setup x <<EOF
#!/bin/sh
# Runs in a new worktree, after .dangle/copy. A failure stops the plan.
# \$DANGLE_PRIMARY is the main checkout, \$DANGLE_WORKTREE this worktree, \$DANGLE_BRANCH its branch.
set -e
$setup
EOF
  write_new .dangle/hooks/gate x <<EOF
#!/bin/sh
# The gate: runs in the worktree before a landing. Exit 0 and the work lands; anything
# else and it does not. Make it the checks you trust: format, lint, tests, build.
set -e
$gate
EOF
  write_new .dangle/hooks/teardown x <<'EOF'
#!/bin/sh
# Runs in a worktree just before it is removed (after a landing or `dangle rm`).
# Save anything worth keeping, e.g. a build cache for the next worktree.
EOF
  ensure_excluded
  say ""
  say "Next: read .dangle/hooks/gate, then dangle doctor --agent, then dangle --dry-run."
  say "Optional: .dangle/hooks/regate <old> <new> (exit 1 = no second gate when $BASE moved),"
  say ".dangle/hooks/done <summary file> (after a run), .dangle/prompt.md and fix-prompt.md."
}

# ---------------------------------------------------------------- skill

skill_text() {
  cat <<'EOF'
---
name: dangle-plans
description: >
  Use when writing implementation plans for dangle (the overnight plan runner), or when
  preparing a repository's existing plans for it: numbering them in run order, splitting
  large ones, marking dependencies, and retiring plans that are already done.
---

# Plans for dangle

dangle runs every `*.md` file directly in the plans folder (`PLANS=` in `.dangle/config`;
`dangle doctor` prints it), one at a time: the first plan in filename order whose
dependencies have landed, again and again. Each plan gets a fresh
worktree from the base branch, an agent implements it, the gate checks it, and only then
does it land. Subfolders are inactive: `done/` holds landed plans, and any other subfolder
(`hold/`, `drafts/`) parks a plan.

## Writing a plan

- **File name:** `NNN-short-name.md`, or with a date `YYYY-MM-DD-NNN-short-name.md`. The number
  is the id (`dangle 865`), and the order of the names is the run order. Make the file with
  `dangle add <short-name> "<title>"`: it takes the next free number (every folder, the base
  branch and the remote's) under a lock, creates the file at once and prints its path, so two
  sessions writing plans at the same time never share a number. Then write into that file.
  `dangle --dry-run` prints the order.
- **One goal.** A plan is one change a single agent session can finish: about 3 to 8 files.
  Two goals make two plans. Aim for 100 to 300 lines (`MAX_LINES`, warned by `dangle lint`).
- **Header** (optional), on one line under the title:
  `<!-- dangle: depends=863,864 agent=claude:sonnet -->`. `depends` makes dangle skip the plan
  until those plans landed; `agent` picks the agent for a hard plan (a command-line `-a` wins).
- **Write for the agent that runs it, not for you.** It starts cold: name the files, the
  functions, the commands and the tests. Say what "done" is.
- **`Done when:`** a line such as ``Done when: `cargo test payroll` `` gives a command dangle runs
  after the gate; the plan only lands when it passes.
- **No landing steps.** Never tell the agent to merge, push, rebase, switch branches, or move
  the plan: dangle does that.
- **Split rather than grow.** If a plan passes ~300 lines, or needs "and also", split it and
  chain the parts with `depends=`.
- The plan must be **committed on the base branch** before a run: a worktree only sees
  committed files.

## Preparing an existing repository

1. Run `dangle init` if `.dangle/` is missing, and check `.dangle/hooks/gate` really checks.
2. Find the plans that are already done: `dangle audit` asks the agent about each plan
   (read-only; a strong model is worth it here: `dangle audit -a claude:sonnet`) and writes
   `.git/dangle/audit.md`. Check the ones it calls done, then `dangle audit --apply` moves them
   to `done/` in one commit. A plan it calls partial gets a short "Corrections" section at
   the top saying what is already there and what is left.
3. Park plans that need a human decision in `hold/`.
4. Put the rest in dependency order, and rename them `NNN-name.md` (keep a leading date if
   the repository uses one), with gaps of 10 so later plans fit between.
5. Split any plan over ~300 lines or with more than one goal; add `depends=` lines.
6. Run `dangle lint` and `dangle --dry-run`; commit the plans.

## Running

- Ids: a plan's number, or without one its name after the date; the first words of a name
  work too (`shop-A1` for `shop-A1-report-links`), in `depends=` as well.
- `dangle` runs everything; `dangle 865 870` runs only those; `dangle 865 --rest` runs 865 first,
  then the rest. `-a claude:haiku` picks the agent for this run.
- One plan runs at a time. For more, start a second `dangle` in another terminal: runners
  claim plans, skip what another one runs, and wait for a dependency another one is running.
- `dangle status` shows what is ready, waiting, running or failed. A failed plan keeps its
  worktree: `dangle 866` continues it, `--fresh` starts it over, `dangle land 866` lands it
  after you fixed it by hand.
EOF
}

cmd_skill() {
  local d
  if [ "${1-}" = --print ]; then skill_text; return; fi
  d="$PRIMARY/.claude/skills/dangle-plans"
  [ -d "$PRIMARY/.agents/skills" ] && d="$PRIMARY/.agents/skills/dangle-plans"
  mkdir -p "$d"
  skill_text > "$d/SKILL.md"
  say "wrote ${d#"$PRIMARY"/}/SKILL.md"
}

# ---------------------------------------------------------------- worktree commands

# branch_of <branch, id, or nothing for the current worktree>
branch_of() {
  local a="${1-}" f
  if [ -z "$a" ]; then
    a=$(git symbolic-ref -q --short HEAD) || die "not on a branch"
    [ "$a" != "$BASE" ] || die "this is $BASE; name the worktree to land"
    printf '%s' "$a"; return
  fi
  if git show-ref -q --verify "refs/heads/$a"; then printf '%s' "$a"; return; fi
  if git show-ref -q --verify "refs/heads/$PREFIX$a"; then printf '%s' "$PREFIX$a"; return; fi
  f=$(find_plan "$a" 2>/dev/null) && git show-ref -q --verify "refs/heads/$PREFIX$(plan_id "$f")" &&
    { printf '%s' "$PREFIX$(plan_id "$f")"; return; }
  die "no branch '$a'"
}

cmd_new() {
  local branch='' from=''
  while [ $# -gt 0 ]; do
    case $1 in --base) from=${2-}; shift ;; -*) die "unknown option $1" ;; *) branch=$1 ;; esac
    shift
  done
  [ -n "$branch" ] || die "usage: dangle new <branch> [--base <branch>]"
  new_worktree "$branch" "${from:-$BASE}" || exit 1
  wt_path "$branch"; echo
}

# every_plan_name: the file name of every plan anywhere: the plans folder and its subfolders on
# disk (written but not committed yet), the base branch, and the remote's base branch (another
# computer's). One per line, duplicates kept.
every_plan_name() {
  find "$PRIMARY/$PLANS" -name '*.md' 2>/dev/null
  git ls-tree -r --name-only "refs/heads/$BASE" -- "$PLANS" 2>/dev/null
  [ -z "$REMOTE" ] || git ls-tree -r --name-only "refs/remotes/$REMOTE/$BASE" -- "$PLANS" 2>/dev/null
}

# cmd_add <short-name> [title...]: makes the next plan file and prints its path. The number is
# one past the highest anywhere (every_plan_name), taken under a lock and the file created at
# once, so two sessions writing plans at the same time never pick the same number.
cmd_add() {
  local name=${1-} title nums top width next dated='' f
  [ -n "$name" ] || die "usage: dangle add <short-name> [title]"
  shift
  case $name in *[!A-Za-z0-9._-]*|-*) die "a plan name is letters, digits, '.', '_' and '-' (got $name)" ;; esac
  title=${*:-$(printf '%s' "$name" | tr '-' ' ')}
  mkdir -p "$PRIMARY/$PLANS"
  take_lock "$STATE/add.lock" "another dangle add" >&2
  nums=$(every_plan_name | sed 's|.*/||' | grep '\.md$' | while read -r f; do plan_id "$f"; done |
    grep -E '^[0-9]+$' || true)
  top=$(printf '%s\n' "$nums" | sed 's/^0*\([0-9]\)/\1/' | sort -n | tail -n 1)
  width=$(printf '%s\n' "$nums" | awk '{ if (length($0) > w) w = length($0) } END { print w + 0 }')
  next=$(printf "%0${width:-1}d" $(( ${top:-0} + 1 )))
  every_plan_name | sed 's|.*/||' | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-' && dated="$(date +%F)-"
  f="$PRIMARY/$PLANS/$dated$next-$name.md"
  if ! ( set -C; printf '# %s\n\n' "$title" > "$f" ) 2>/dev/null; then
    drop_lock "$STATE/add.lock"
    die "${f##*/} exists already"
  fi
  drop_lock "$STATE/add.lock"
  say "$f"
}

cmd_land() {
  local name='' fix='' fixagent='' keep='' branch plan='' f spec
  [ -z "${DANGLE:-}" ] || die "refused: an agent run by dangle never lands; dangle lands this branch after you finish"
  while [ $# -gt 0 ]; do
    case $1 in
      --fix) fix=1 ;;
      --fix-agent) fix=1; fixagent=${2-}; shift ;;
      --fix-agent=*) fix=1; fixagent=${1#*=} ;;
      --keep) keep=1 ;; --now) NOW=1 ;; --no-gate) NOGATE=1 ;;
      -*) die "unknown option $1" ;; *) name=$1 ;;
    esac
    shift
  done
  branch=$(branch_of "$name")
  case $branch in "$PREFIX"*)
    f=$(find_plan "${branch#"$PREFIX"}" 2>/dev/null) && [ "$(plan_id "$f")" = "${branch#"$PREFIX"}" ] && plan=$f ;;
  esac
  require_clean_base
  if [ -n "$fix" ]; then
    spec=${fixagent:-${DANGLE_FIX_AGENT:-$(cfg FIX_AGENT "$(cfg AGENT)")}}
    [ -n "$spec" ] || die "--fix needs an AGENT in .dangle/config"
    DANGLE_T_plan=${plan:+$PLANS/${plan##*/}} DANGLE_T_branch=$branch DANGLE_T_gate=$(gate_desc)
    export DANGLE_T_plan DANGLE_T_branch DANGLE_T_gate
  fi
  trap 'cleanup; exit 130' INT TERM
  trap cleanup EXIT
  say "dangle: landing $branch onto $BASE"
  [ -n "$plan" ] && claim "$(plan_id "$plan")" || true
  if land "$branch" "$plan" "${fix:+$spec}" 1 "$keep"; then
    [ -n "$plan" ] && unclaim "$(plan_id "$plan")"
    art_carrot
    return 0
  fi
  err "$FAIL_REASON"
  exit 1
}

cmd_rm() {
  local name='' force=''
  while [ $# -gt 0 ]; do
    case $1 in -f|--force) force=1 ;; -*) die "unknown option $1" ;; *) name=$1 ;; esac
    shift
  done
  [ -n "$name" ] || die "usage: dangle rm <branch> [-f]"
  remove_worktree "$(branch_of "$name")" "$force" || die "not removed (uncommitted changes or an unmerged branch? -f forces)"
}

cmd_list() {
  git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w "\t" substr($0,19)}' |
  while IFS="$(printf '\t')" read -r w b; do
    case $w in "$PRIMARY/$WORKTREES"/*) ;; *) continue ;; esac
    printf '%-40s +%s -%s  %6s%s\n' "$b" \
      "$(git rev-list --count "refs/heads/$BASE..refs/heads/$b")" \
      "$(git rev-list --count "refs/heads/$b..refs/heads/$BASE")" \
      "$(human_kb "$(wt_kb "$w")")" \
      "$( [ -n "$(git -C "$w" status --porcelain)" ] && echo '  (changes)')"
  done
}

cmd_prune() {
  local days="$PRUNE_DAYS" maxg="$PRUNE_MAX_GB" dry=0 all=0 rm=0
  while [ $# -gt 0 ]; do
    case $1 in
      -n|--dry-run) dry=1 ;;
      --days) days=${2-}; shift ;;
      --days=*) days=${1#*=} ;;
      --max-gb) maxg=${2-}; shift ;;
      --max-gb=*) maxg=${1#*=} ;;
      --all) all=1 ;;
      --rm) rm=1 ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown option $1 (dangle --help)" ;;
      *) die "unexpected argument $1 (dangle --help)" ;;
    esac
    shift
  done
  case $days in ''|*[!0-9]*) die "--days takes a number of days" ;; esac
  case $maxg in ''|*[!0-9]*) die "--max-gb takes a number of gigabytes" ;; esac
  [ -n "$(wt_branches)" ] || { say "dangle: no worktrees"; return 0; }
  if ! has_hook prune && [ "$rm" = 0 ]; then
    say "dangle: no .dangle/hooks/prune, so dangle does not know what is disposable here"
    say "        write one (see the README) or pass --rm to remove worktrees with no work"
    return 0
  fi
  prune_all "$days" "$maxg" "$dry" "$all" "$rm" 1
  return 0
}

cmd_path() {
  [ -n "${1-}" ] || die "usage: dangle path <branch|id>"
  wt_path "$(branch_of "$1")"; echo
}

# ---------------------------------------------------------------- main

main() {
  case ${1-} in
    -h|--help|help) usage; return 0 ;;
    -V|--version|version) say "dangle $VERSION"; return 0 ;;
  esac
  [ "${1-} ${2-}" = "skill --print" ] && { skill_text; return 0; }
  find_repo
  settings
  clear_tombstones
  case ${1-} in
    status|lint|doctor|init|skill|new|land|queue|rm|prune|list|path|audit|add) ;;
    *)
      # A run keeps the computer awake for the night.
      if [ -z "${DANGLE_AWAKE:-}" ] && command -v systemd-inhibit >/dev/null 2>&1 &&
        systemd-inhibit --no-ask-password --what=sleep:idle --who=dangle --why=check true 2>/dev/null; then
        DANGLE_AWAKE=1 exec systemd-inhibit --no-ask-password --what=sleep:idle --who=dangle --why="running plans" "$0" "$@"
      fi ;;
  esac
  case ${1-} in
    run) shift; cmd_run "$@" ;;
    status) cmd_status ;;
    audit) shift; cmd_audit "$@" ;;
    lint) cmd_lint ;;
    add) shift; cmd_add "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    init) cmd_init ;;
    skill) shift; cmd_skill "$@" ;;
    new) shift; cmd_new "$@" ;;
    land) shift; cmd_land "$@" ;;
    queue) cmd_queue ;;
    rm) shift; cmd_rm "$@" ;;
    prune) shift; cmd_prune "$@" ;;
    list) cmd_list ;;
    path) shift; cmd_path "$@" ;;
    *) cmd_run "$@" ;;
  esac
}

main "$@"
